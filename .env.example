# Local development only. Do not commit a real token.
# Prefer passing this value with --dart-define instead of storing it in a file:
# flutter run --dart-define=TMDB_READ_ACCESS_TOKEN=xxxxx
# TMDB_READ_ACCESS_TOKEN=your-local-token
TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p

STREAMING_VIDSRC_DOMAINS=https://vidsrcme.su,https://vsembed.ru,https://vidsrc-embed.ru,https://vidsrc-embed.su,https://vsrc.su
STREAMING_VIDSRC_ENABLED=true
STREAMING_2EMBED_DOMAINS=https://www.2embed.cc,https://www.2embed.skin
STREAMING_2EMBED_ENABLED=true
STREAMING_2EMBED_MOVIE_TEMPLATE={domain}/embed/{id}
STREAMING_2EMBED_EPISODE_TEMPLATE={domain}/embedtv/{id}&s={season}&e={episode}
STREAMING_ALLOWED_HOSTS=
STREAMING_TIMEOUT_SECONDS=18
