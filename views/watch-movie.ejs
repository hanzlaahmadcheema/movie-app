    <meta name="twitter:site" content="@HA_Entertainment">
    <meta name="twitter:title" content="Watch <%= movie.title %> - Free Full HD Movie Streaming">
    <meta name="twitter:description" content="Watch <%= movie.title %> in Full HD for free on HA Entertainment. Stream without ads and enjoy the best quality.">
    <meta name="twitter:image" content="https://image.tmdb.org/t/p/w780<%= movie.backdropPath %>">
    <meta name="twitter:player" content="https://multiembed.mov/?video_id=<%= movie.id %>&tmdb=1">

    <!-- Stylesheets -->
    <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/4.1.3/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://use.fontawesome.com/releases/v5.3.1/css/all.css">
    <link rel="stylesheet" href="/css/theme_1.css">

    <!-- Schema Markup for Movie Watching Page -->
    <script type="application/ld+json">
        {
          "@context": "https://schema.org",
          "@type": "Movie",
          "name": "<%= movie.title %>",
          "url": "https://ha-entertainment.com/movie/<%= movie.id %>",
          "description": "<%= movie.overview %>",
          "image": "https://image.tmdb.org/t/p/w780<%= movie.backdropPath %>",
          "genre": [
            <% if (movie.genres && movie.genres.length > 0) { %>
              <% movie.genres.forEach((genre, index) => { %>
                "<%= genre.name %>"<% if (index < movie.genres.length - 1) { %>,<% } %>
              <% }) %>
            <% } else { %>
              "Unknown"
            <% } %>
          ],
          "actor": [
            <% if (cast && cast.length > 0) { %>
              <% cast.forEach((member, index) => { %>
                {
                  "@type": "Person",
                  "name": "<%= member.name %>",
                  "character": "<%= member.character %>",
                  "image": "https://image.tmdb.org/t/p/w185<%= member.profilePath %>"
                }<% if (index < cast.length - 1) { %>,<% } %>
              <% }) %>
            <% } %>
          ],
          "productionCompany": [
            <% if (movie.production_companies && movie.production_companies.length > 0) { %>
              <% movie.production_companies.forEach((company, index) => { %>
                {
                  "@type": "Organization",
                  "name": "<%= company.name %>",
                  "logo": {
                    "@type": "ImageObject",
                    "url": "https://image.tmdb.org/t/p/w185<%= company.logo_path %>"
                  }
                }<% if (index < movie.production_companies.length - 1) { %>,<% } %>
              <% }) %>
            <% } %>
          ],
          "releaseDate": "<%= movie.release_date %>",
          "duration": "<%= movie.runtime %> minutes",
          "reviewRating": {
            "@type": "Rating",
            "ratingValue": "<%= movie.vote_average %>",
            "reviewCount": "<%= movie.vote_count %>"
          },
          "video": {
            "@type": "VideoObject",
            "name": "<%= movie.title %>",
            "description": "<%= movie.overview %>",
            "contentUrl": "https://multiembed.mov/?video_id=<%= movie.id %>&tmdb=1",
            "thumbnailUrl": "https://image.tmdb.org/t/p/w780<%= movie.backdropPath %>",
            "embedUrl": "https://multiembed.mov/?video_id=<%= movie.id %>&tmdb=1",
            "uploadDate": "<%= movie.release_date %>T08:00:00+08:00"
          }
        }
        </script>
        
        

