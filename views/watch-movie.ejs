    <meta name="robots" content="index, follow">
    <meta http-equiv="content-language" content="en" />
    <meta name="description" content="<%= movie.overview %> - Watch <%= movie.title %> in Full HD for free on HA Entertainment. Stream without ads and enjoy the best quality." />
    <meta name="keywords" content="watch <%= movie.title %> ha entertainment, watch <%= movie.title %> online ha entertainment, watch <%= movie.title %> free ha entertainment, watch <%= movie.title %>, free movie streaming, HD movies, <%= movie.title %> full HD, free movies online, watch movies without ads" />
    <meta name="viewport" content="width=device-width, initial-scale=1, minimum-scale=1, maximum-scale=1" />

    <!-- Canonical Link -->
    <link rel="canonical" href="https://ha-entertainment.com/watch-movie/<%= movie.id %>" />

    <!-- Favicon and Icons -->
