    <link rel="apple-touch-icon" sizes="180x180" href="https://ha-entertainment.com/images/apple-touch-icon.png">

    <!-- Open Graph Meta Tags -->
    <meta property="og:type" content="video.movie" />
    <meta property="og:title" content="Watch <%= movie.title %> - Free Full HD Movie Streaming" />
    <meta property="og:url" content="https://ha-entertainment.com/watch-movie/<%= movie.id %>" />
    <meta property="og:image" content="https://image.tmdb.org/t/p/w780<%= movie.backdropPath %>" />
    <meta property="og:image:width" content="500">
    <meta property="og:image:height" content="750">
    <meta property="og:description" content="Watch <%= movie.title %> in Full HD for free on HA Entertainment. Stream without ads and enjoy the best quality." />
    <meta property="og:site_name" content="HA Entertainment" />
    <meta property="og:video" content="https://multiembed.mov/?video_id=<%= movie.id %>&tmdb=1" />

    <!-- Twitter Card Meta Tags -->
