    <script>
function showTrailerModal(trailerId, movieTitle) {
    const modal = document.getElementById('modalfilter');
    const modalContent = document.getElementById('modalContent');
    const titleElement = document.querySelector('.description');

    if (modal && modalContent && titleElement) {
        // Update modal content
        titleElement.textContent = movieTitle;
        modalContent.innerHTML = `<iframe height="480" src="https://www.youtube.com/embed/${trailerId}?autoplay=1" frameborder="0" allowfullscreen></iframe>`;

         // Show the modal
         $(modal).modal('show');

        $(modal).on('hidden.bs.modal', function () {
            modalContent.innerHTML = ''; // Remove iframe src to stop video
        });
    } else {
        console.error('Modal or modal content not found.');
    }
}
    </script>
