                                                        <span>Watch Trailer</span>
                                                    </div>
                                                </div>                                                
                                                <div class="spacing"></div>
                                                <div class="film-rating" id="vote-info"
                                                    data-movie-id="<%= movie.id || '' %>">
                                                    <div class="is-rate">
                                                        <div class="stars mr-2">
                                                            <div class="fill <%= getRatingClass(movie.vote_average) %>">
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <span class="rating">
                                                        <%= movie.vote_average.toFixed(1) || 'N/A' %>
