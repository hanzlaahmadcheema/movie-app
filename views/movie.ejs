<!DOCTYPE html>
<html lang="en">

<head>
    <title>
        <%= movie.title %> - Watch Free Movies & TV Series Online - H.A Entertainment
    </title>

    <!-- Meta Tags -->
    <meta charset="UTF-8">
    <meta name="robots" content="index, follow">
    <meta http-equiv="content-language" content="en" />
    <meta name="description"
        content="<%= movie.overview %> Watch <%= movie.title %> and other movies in Full HD for free at H.A Entertainment." />
    <meta name="keywords"
        content="<%= movie.title %>, free movies, HD movies, watch <%= movie.title %>, movie details, <%= movie.title %> online, free movie streaming" />
    <meta name="viewport" content="width=device-width, initial-scale=1, minimum-scale=1, maximum-scale=1" />

    <!-- Canonical Link -->
    <link rel="canonical" href="https://ha-entertainment.vercel.app/movie/<%= movie.id %>" />

    <!-- Favicon and Icons -->
    <link rel="shortcut icon" href="https://ha-entertainment.vercel.app/images/logo.png" type="image/x-icon" />
    <link rel="icon" type="image/png" sizes="32x32" href="https://ha-entertainment.vercel.app/images/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="https://ha-entertainment.vercel.app/images/favicon-16x16.png">
    <link rel="apple-touch-icon" sizes="180x180" href="https://ha-entertainment.vercel.app/images/apple-touch-icon.png">

    <!-- Open Graph Meta Tags -->
    <meta property="og:type" content="movie" />
    <meta property="og:title" content="<%= movie.title %> - Watch Free Movies & TV Series Online" />
    <meta property="og:url" content="https://ha-entertainment.vercel.app/movie/<%= movie.id %>" />
    <meta property="og:image" content="https://image.tmdb.org/t/p/original<%= movie.backdrop_path %>" />
    <meta property="og:image:width" content="500">
    <meta property="og:image:height" content="750">
    <meta property="og:description"
        content="<%= movie.overview %> Watch <%= movie.title %> and enjoy streaming in Full HD quality for free on H.A Entertainment." />
    <meta property="og:site_name" content="H.A Entertainment" />

    <!-- Twitter Card Meta Tags -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:site" content="@HA_Entertainment">
    <meta name="twitter:title" content="<%= movie.title %> - Watch Free Movies & TV Series Online">
    <meta name="twitter:description"
        content="<%= movie.overview %> Watch <%= movie.title %> and other movies in Full HD quality for free on H.A Entertainment.">
    <meta name="twitter:image" content="https://image.tmdb.org/t/p/original<%= movie.backdrop_path %>">

    <!-- Stylesheets -->
    <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/4.1.3/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://use.fontawesome.com/releases/v5.3.1/css/all.css">
    <link rel="stylesheet" href="/css/theme_1.css">

    <!-- Schema Markup for Movie Details Page -->
    <script type="application/ld+json">
            {
              "@context": "https://schema.org",
              "@type": "Movie",
              "name": "<%= movie.title %>",
              "url": "https://ha-entertainment.vercel.app/movie/<%= movie.id %>",
              "image": "https://image.tmdb.org/t/p/original<%= movie.backdrop_path %>",
              "description": "<%= movie.overview %>",
              "reviewRating": {
                "@type": "Rating",
                "ratingValue": "<%= movie.vote_average %>",
                "reviewCount": "<%= movie.vote_count %>"
              },
              "genre": [
                <% movie.genres.forEach(function(genre, index) { %>
                  "<%= genre.name %>"
                  <% if (index < movie.genres.length - 1) { %>, <% } %>
                <% }) %>
              ],
              "actor": [
        <% movie.cast.forEach(function(actor, index) { %>
          {
            "@type": "Person",
            "name": "<%= actor.name %>",
            "characterName": "<%= actor.character %>"
          }
          <% if (index < movie.cast.length - 1) { %>, <% } %>
        <% }) %>
      ],
              "productionCompany": [
                <% movie.production_companies.forEach(function(company, index) { %>
                  {
                    "@type": "Organization",
                    "name": "<%= company.name %>",
                    "logo": {
                      "@type": "ImageObject",
                      "url": "https://image.tmdb.org/t/p/original<%= company.logo_path %>"
                    }
                  }
                  <% if (index < movie.production_companies.length - 1) { %>, <% } %>
                <% }) %>
              ],
              "releaseDate": "<%= movie.release_date %>",
              "productionCountry": [
                <% movie.production_countries.forEach(function(country, index) { %>
                  {
                    "@type": "Place",
                    "name": "<%= country.name %>"
                  }
                  <% if (index < movie.production_countries.length - 1) { %>, <% } %>
                <% }) %>
              ],
              "video": {
                "@type": "VideoObject",
                "name": "<%= movie.title %>",
                description: "<%= movie.overview %>",
                "contentUrl": "https://ha-entertainment.netlify.app/embed/watch-embed?id=<%= movie.id %>",
                "thumbnailUrl": "https://image.tmdb.org/t/p/original<%= movie.backdrop_path %>",
                "embedUrl": "https://ha-entertainment.netlify.app/embed/watch-embed?id=<%= movie.id %>",
                "uploadDate": "<%= movie.release_date %>T08:00:00+08:00"
              },
              "interactionStatistic": {
                "@type": "InteractionCounter",
                "interactionType": { "@type": "WatchAction" }
              }
            }
            </script>


    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-VS8TC16J1Q"></script>
    <script>
        window.dataLayer = window.dataLayer || [];
        function gtag() { dataLayer.push(arguments); }
        gtag('js', new Date());

        gtag('config', 'G-VS8TC16J1Q');
    </script>
</head>


