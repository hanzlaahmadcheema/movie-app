<!DOCTYPE html>
<html lang="en">

<head>
    <title>
        Watch <%= movie.title %> - Free Full HD Movie Streaming - HA Entertainment
    </title>

    <!-- Meta Tags -->
    <meta charset="UTF-8">
    <meta name="robots" content="index, follow">
    <meta http-equiv="content-language" content="en" />
    <meta name="description"
        content="<%= movie.overview %> Watch <%= movie.title %> and other movies in Full HD for free at HA Entertainment." />
    <meta name="keywords"
        content="watch <%= movie.title %> ha entertainment, watch <%= movie.title %> online ha entertainment, watch <%= movie.title %> free ha entertainment, <%= movie.title %>, free movies, HD movies, watch <%= movie.title %>, movie details, <%= movie.title %> online, free movie streaming" />
    <meta name="viewport" content="width=device-width, initial-scale=1, minimum-scale=1, maximum-scale=1" />

    <!-- Canonical Link -->
    <link rel="canonical" href="https://www.ha-entertainment.com/movie/<%= movie.id %>" />

    <!-- Favicon and Icons -->
    <link rel="shortcut icon" href="https://www.ha-entertainment.com/images/logo.png" type="image/x-icon" />
    <link rel="icon" type="image/png" sizes="32x32" href="https://www.ha-entertainment.com/images/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="https://www.ha-entertainment.com/images/favicon-16x16.png">
    <link rel="apple-touch-icon" sizes="180x180" href="https://www.ha-entertainment.com/images/apple-touch-icon.png">

    <!-- Open Graph Meta Tags -->
    <meta property="og:type" content="movie" />
    <meta property="og:title" content="<%= movie.title %> - Watch Free Movies & TV Series Online" />
    <meta property="og:url" content="https://www.ha-entertainment.com/movie/<%= movie.id %>" />
    <meta property="og:image" content="https://image.tmdb.org/t/p/w780<%= movie.backdrop_path %>" />
    <meta property="og:image:width" content="500">
    <meta property="og:image:height" content="750">
    <meta property="og:description"
        content="<%= movie.overview %> Watch <%= movie.title %> and enjoy streaming in Full HD quality for free on HA Entertainment." />
    <meta property="og:site_name" content="HA Entertainment" />
    <meta property="og:video" content="https://multiembed.mov/?video_id=<%= movie.id %>&tmdb=1" />


    <!-- Twitter Card Meta Tags -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:site" content="@HA_Entertainment">
    <meta name="twitter:title" content="<%= movie.title %> - Watch Free Movies & TV Series Online">
    <meta name="twitter:description"
        content="<%= movie.overview %> Watch <%= movie.title %> and other movies in Full HD quality for free on HA Entertainment.">
    <meta name="twitter:image" content="https://image.tmdb.org/t/p/w780<%= movie.backdrop_path %>">
    <meta name="twitter:player" content="https://multiembed.mov/?video_id=<%= movie.id %>&tmdb=1">

    <!-- Stylesheets -->
    <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/4.1.3/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://use.fontawesome.com/releases/v5.3.1/css/all.css">
    <link rel="stylesheet" href="/css/theme_1.css">

    <!-- Schema Markup for Movie Details Page -->
    <script type="application/ld+json">
        {
          "@context": "https://schema.org",
          "@type": "Movie",
          "name": "<%= movie.title %>",
          "url": "https://www.ha-entertainment.com/movie/<%= movie.id %>",
          "image": "https://image.tmdb.org/t/p/w780<%= movie.backdrop_path %>",
          "description": "<%= movie.overview %>",
          "reviewRating": {
            "@type": "Rating",
            "ratingValue": "<%= movie.vote_average %>",
            "reviewCount": "<%= movie.vote_count %>"
          },
          "genre": [
            <% movie.genres.forEach(function(genre, index) { %>
              "<%= genre.name %>"<% if (index < movie.genres.length - 1) { %>, <% } %>
            <% }) %>
          ],
          "actor": [
            <% movie.cast.forEach(function(actor, index) { %>
              {
                "@type": "Person",
                "name": "<%= actor.name %>",
                "characterName": "<%= actor.character %>"
              }<% if (index < movie.cast.length - 1) { %>, <% } %>
            <% }) %>
          ],
          "productionCompany": [
            <% movie.production_companies.forEach(function(company, index) { %>
              {
                "@type": "Organization",
                "name": "<%= company.name %>",
                "logo": {
                  "@type": "ImageObject",
                  "url": "https://image.tmdb.org/t/p/w185<%= company.logo_path %>"
                }
              }<% if (index < movie.production_companies.length - 1) { %>, <% } %>
            <% }) %>
          ],
          "releaseDate": "<%= movie.release_date %>",
          "productionCountry": [
            <% movie.production_countries.forEach(function(country, index) { %>
              {
                "@type": "Place",
                "name": "<%= country.name %>"
              }<% if (index < movie.production_countries.length - 1) { %>, <% } %>
            <% }) %>
          ],
          "video": {
            "@type": "VideoObject",
            "name": "<%= movie.title %>",
            "description": "<%= movie.overview %>",
            "contentUrl": "https://multiembed.mov/?video_id=<%= movie.id %>&tmdb=1",
            "thumbnailUrl": "https://image.tmdb.org/t/p/w780<%= movie.backdrop_path %>",
            "embedUrl": "https://multiembed.mov/?video_id=<%= movie.id %>&tmdb=1",
            "uploadDate": "<%= movie.release_date %>T08:00:00+08:00"
          },
          "interactionStatistic": {
            "@type": "InteractionCounter",
            "interactionType": { "@type": "WatchAction" },
            "userInteractionCount": 5647018
          }
        }
        </script>
        


    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-VS8TC16J1Q"></script>
    <script>
        window.dataLayer = window.dataLayer || [];
        function gtag() { dataLayer.push(arguments); }
        gtag('js', new Date());

        gtag('config', 'G-VS8TC16J1Q');
    </script>
<script type="text/javascript">
    (function(c,l,a,r,i,t,y){
        c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
        t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
        y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
    })(window, document, "clarity", "script", "nr75009c7m");
</script>
</head>


