                                                </div>
                                            </div>
                                            <div class="item">
                                                <div class="name">Production</div>
                                                <div class="item-body">
                                                    <% if (movie.production_companies &&
                                                        movie.production_companies.length) { %>
                                                        <% movie.production_companies.forEach(company=> { %>
                                                            <a href="/production/<%= company.id %>"
                                                                title="<%= company.name %>">
                                                                <%= company.name %>
                                                            </a>
                                                            <%= company.id < movie.production_companies.length - 1 ? ','
                                                                : '' %>
                                                                <% }); %>
                                                                    <% } else { %>
                                                                        <span>No production companies available.</span>
                                                                        <% } %>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
            </section>

            <section class="section-default section-flow-vertical section-film-list is-carousel">
                <div class="container">
                    <div class="section-header">
                        <div class="is-title">
                            <h3 class="heading-md">You may also like</h3>
                        </div>
                        <div class="flex-grow"></div>
                    </div>
                </div>
                <div id="carousel-related-movies" class="film-carousel">
                    <div class="swiper-container">
                        <div class="swiper-wrapper">
                            <% relatedMovies.forEach(relatedMovies=> { %>
                                <div class="swiper-slide">
                                    <div class="item-film">
                                        <a href="/movie/<%= relatedMovies.id %>" class="film-mask"></a>
                                        <div class="film-thumbnail">
                                            <div class="badge-tag quality">HD</div>
                                            <img class="film-thumbnail-img"
                                                src="https://image.tmdb.org/t/p/w500<%= relatedMovies.poster_path %>"
                                                alt="<%= relatedMovies.title %>">
                                        </div>
                                        <div class="film-detail">
                                            <h3 class="film-name sum-2">
                                                <a href="/movie/<%= relatedMovies.id %>"
                                                    title="<%= relatedMovies.title %>">
                                                    <%= relatedMovies.title %>
                                                </a>
                                            </h3>
                                            <div class="film-info">
