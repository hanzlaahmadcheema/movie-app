        <!--/// Page body ///-->
        <div id="page-detail">
            <section class="section-detail is-detail-tv">
                <div class="slide-cover">
                    <img src="https://image.tmdb.org/t/p/w500/<%= movie.backdrop_path || 'default.jpg' %>"
                        alt="<%= movie.title %>">
                </div>
                <div class="container">
                    <div class="detail-wrap">
                        <div class="detail-elements">
                            <div class="one-block">
                                <div class="is-thumbnail">
                                    <div class="film-thumbnail">
                                        <div class="badge-tag quality">HD</div>
                                        <img class="film-thumbnail-img"
                                            src="https://image.tmdb.org/t/p/w500/<%= movie.poster_path || 'default.jpg' %>"
                                            alt="<%= movie.title %>">
                                    </div>
                                </div>
                                <div class="is-caption backdrop-blur-50">
                                    <div class="is-top">
                                        <div class="detail-top">
                                            <div class="is-back">
                                                <a href="/movies" class="btn btn-light btn-radius w-icon">
                                                    <i class="fas fa-angle-left mr-2"></i>Movies
                                                </a>
                                            </div>
                                        </div>
                                        <h3 class="heading-xl">
                                            <%= movie.title || 'Unknown Title' %>
                                        </h3>
                                        <div class="is-action">
                                            <div class="div-buttons">
                                                <a href="/watch-movie/<%= movie.id || '' %>"
                                                    class="btn btn-primary w-icon">
                                                    <i class="fas fa-play mr-3"></i>Watch now
                                                </a>
                                            </div>
                                            <div class="spacing"></div>
                                            <div class="for-user">
                                                <div class="film-rating" id="vote-info"
                                                    data-movie-id="<%= movie.id || '' %>">
                                                    <div class="is-rate">
                                                        <div class="stars mr-2">
                                                            <div class="fill <%= getRatingClass(movie.vote_average) %>">
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <span class="rating">
                                                        <%= movie.vote_average.toFixed(1) || 'N/A' %>
                                                    </span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="is-bot">
                                        <div class="item-description mb-4">
                                            <div class="item-body">
                                                <div class="name mb-2"><strong>Overview</strong></div>
                                                <div class="description">
                                                    <%= movie.overview || 'No overview available.' %>
                                                </div>
                                                <div class="desc-more mt-2" style="position: relative;">
