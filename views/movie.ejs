                                                        <i class="fas fa-plus mr-2"></i>read full
                                                    </button>
                                                    <div class="dropdown-menu dropdown-primary mine-dropdown">
                                                        <div class="dropdown-text">
                                                            <p>
                                                                <%= movie.overview || 'No overview available.' %>
                                                            </p>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="others">
                                            <div class="item item-casts">
                                                <div class="name">Casts</div>
                                                <div class="item-body">
                                                    <% if (movie.cast && movie.cast.length) { %>
                                                        <% movie.cast.forEach(castMember=> { %>
                                                            <a href="/cast/<%= castMember.id %>"
                                                                title="<%= castMember.name %>">
                                                                <%= castMember.name %>
                                                            </a>
                                                            <%= castMember !==movie.cast[movie.cast.length - 1] ? ', '
                                                                : '' %>
                                                                <% }); %>
                                                                    <% } else { %>
                                                                        <span>No cast information available.</span>
                                                                        <% } %>
                                                </div>
                                            </div>
                                            <div class="item item-genres">
                                                <div class="name">Genres</div>
                                                <div class="item-body">
                                                    <% if (movie.genres && movie.genres.length) { %>
                                                        <% movie.genres.forEach(genre=> { %>
                                                            <a href="/genre/<%= genre.id %>" rel="tag"
                                                                title="<%= genre.name %>">
                                                                <%= genre.name %>
                                                            </a>
                                                            <%= genre.id < movie.genres.length - 1 ? ',' : '' %>
                                                                <% }); %>
                                                                    <% } else { %>
                                                                        <span>No genres available.</span>
                                                                        <% } %>
                                                </div>
                                            </div>
                                            <div class="item">
                                                <div class="name">Duration</div>
                                                <div class="item-body">
                                                    <span>
                                                        <%= movie.runtime || 'N/A' %> min
                                                    </span>
                                                </div>
                                            </div>
                                            <div class="item">
                                                <div class="name">Country</div>
                                                <div class="item-body">
                                                    <% if (movie.production_countries &&
                                                        movie.production_countries.length) { %>
                                                        <a href="/country/<%= movie.production_countries[0].iso_3166_1 %>"
                                                            title="<%= movie.production_countries[0].name %>">
                                                            <%= movie.production_countries[0].name %>
                                                        </a>
                                                        <% } else { %>
                                                            <span>Unknown</span>
                                                            <% } %>
                                                </div>
                                            </div>
                                            <div class="item">
                                                <div class="name">IMDb</div>
                                                <div class="item-body">
                                                    <span>
