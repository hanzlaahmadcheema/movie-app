    <script>
        document.getElementById('contactForm').addEventListener('submit', function (event) {
            event.preventDefault(); // Prevent the default form submission

            // Collect form data
            const formData = new FormData(this);
            const name = formData.get('name');
            const email = formData.get('email');
            const subject = formData.get('subject');
            const message = formData.get('message');

            // Create the content for the modal
            const modalContent = `
                <p><strong>Name:</strong> ${name}</p>
                <p><strong>Email:</strong> ${email}</p>
                <p><strong>Subject:</strong> ${subject}</p>
                <p><strong>Message:</strong> ${message}</p>
            `;

            // Set the content in the modal
            document.getElementById('modalContent').innerHTML = modalContent;

            // Construct the message
            const textMessage = `\`Hello!%20H.A\`%0A%0A*Name:*%20_${encodeURIComponent(name)}_%0A*Email:*%20_${encodeURIComponent(email)}_%0A*Subject:*%20\`\`\`${encodeURIComponent(subject)}\`\`\`%0A*Message:*%0A> ${encodeURIComponent(message)}`;
            

            // Update the WhatsApp link
            const whatsappLink = `https://api.whatsapp.com/send?phone=923020568468&text=${textMessage}`;
            document.getElementById('whatsappLink').href = whatsappLink;
            // Show the modal
            $('#modalfilter').modal('show');

            // Optionally, you can clear the form fields
            this.reset();
        });
    </script>

