    <script src="/js/app.min.js"></script>
    <script src="/js/search.js"></script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        $(document).ready(function() {
            // Handle season selection
            $('.ss-item').click(function() {
                var seasonId = $(this).data('id');
                var seasonNumber = $(this).find('.ss-name strong').text();
                
                // Update the current season display
                $('#current-ss').text('Season ' + seasonNumber);
    
                // Load the episodes for the selected season
                $.ajax({
                    url: `/watch-series/<%= seriesId %>/season/${seasonId}`,
                    method: 'GET',
                    success: function(response) {
                        // Replace the episode list with the new episodes
                        $('#eps-list').html($(response).find('#eps-list').html());
                    },
                    error: function() {
                        alert('Failed to load season details.');
                    }
                });
    
                // Mark the selected season as active
                $('.ss-item').removeClass('active');
                $(this).addClass('active');
            });
    
            // Handle server selection
            $('.sv-item').click(function() {
                var serverName = $(this).find('.sv-name strong').text();
                var serverUrl = $(this).data('id'); // Ensure this corresponds to the server URL
                var episodeId = $('.ep-item.on-air').data('id'); // Get the current episode ID
    
                // Update the current server display
                $('#current-server').text('Server ' + serverName);
    
                // Update the iframe source
                $('#iframe-player').attr('src', serverUrl + episodeId);
    
                // Mark the selected server as active
                $('.sv-item').removeClass('active');
                $(this).addClass('active');
            });
        });
    </script>
    

    <!-- End: Javascript -->
