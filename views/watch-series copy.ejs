                                                <div class="span1"></div>
                                                <div class="span2"></div>
                                                <div class="span3"></div>
                                            </div>
                                        </div>
                                        <% if (currentEpisode && currentSeason) { %>
                                            <iframe id="iframe-player" width="100%" height="500" scrolling="no" frameborder="0"
