    <!-- Begin: Javascript -->
    <script src="https://code.jquery.com/jquery-3.3.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.1.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/app.min.js"></script>
    <script src="/js/search.js"></script>
<script>
    document.addEventListener('DOMContentLoaded', function () {
    const seriesId = '<%= series.id %>';
    const seasonDropdown = document.querySelector('.mine-dropdown');
    const currentSeasonElement = document.getElementById('current-ss');
    const episodesListContainer = document.querySelector('.eps-list');
    const iframe = document.getElementById('iframe-player');
    const currentServerElement = document.getElementById('current-server');

    // Assign EJS variables to JavaScript variables
    const currentEpisodeId = '<%= currentEpisode.id %>';
    const currentEpisodeNumber = '<%= currentEpisode.episode_number %>';
    const currentSeasonNumber = '<%= currentSeason.season_number %>';

    // Initial setup for the first episode and season
    const initialEpisodeId = currentEpisodeId;
    const initialSeasonNumber = currentSeasonNumber;
    const initialEpisodeNumber = currentEpisodeNumber;

    // Define your server URLs with placeholders
    const servers = [
        { id: '1', name: 'H.A', url: `https://ha-entertainment.netlify.app/embed/watch-embed?id={episode_id}` },
        { id: '2', name: 'UpCloud', url: `https://vidsrc.xyz/embed/tv?tmdb=2734&season={season_number}&episode={episode_number}` },
        { id: '3', name: 'MegaCloud', url: `https://www.2embed.cc/embedtv/2734&season={season_number}&episode={episode_number}` },
        { id: '4', name: 'TVUniverse', url: `https://movieuniverse.lol/embedtv/2734&season={season_number}&episode={episode_number}` }
    ];

    document.querySelectorAll('.dropdown-item.sv-item').forEach(serverItem => {
        console.log('Original URL:', serverItem.getAttribute('data-url'));
    });

    function updateActiveEpisode(episodeId, episodeNumber, seasonNumber) {
        console.log('Updating Active Episode:', { episodeId, episodeNumber, seasonNumber });

        // Update the active episode
        document.querySelectorAll('.ep-item').forEach(item => {
            item.classList.remove('on-air');
        });
        document.querySelector(`.ep-item[data-id="${episodeId}"]`).classList.add('on-air');

        // Update iframe source
        const activeServerItem = document.querySelector('.dropdown-item.sv-item.active');
        if (activeServerItem) {
            const serverUrl = activeServerItem.getAttribute('data-url')
                .replace('{episode_id}', episodeId)
                .replace('{season_number}', seasonNumber)
                .replace('{episode_number}', episodeNumber)
                .replace('{seriesId}', seriesId);
            iframe.src = serverUrl;
            console.log('Updated iframe source:', serverUrl);
        }

        // Update the server links
        document.querySelectorAll('.dropdown-item.sv-item').forEach(serverItem => {
            console.log('Original URL:', serverItem.getAttribute('data-url'));
            serverItem.setAttribute(
                'data-url',
                serverItem.getAttribute('data-url')
                    .replace('{episode_id}', episodeId)
                    .replace('{season_number}', seasonNumber)
                    .replace('{episode_number}', episodeNumber)
                    .replace('{seriesId}', seriesId)
            );
            console.log('Updated URL:', serverItem.getAttribute('data-url'));
        });
    }

    function updateSeasonEpisodes(seasonNumber) {
        console.log('Updating Season Episodes:', seasonNumber);

        fetch(`/api/series/${seriesId}/season/${seasonNumber}`)
            .then(response => response.json())
            .then(data => {
                // Update the episodes list
                episodesListContainer.innerHTML = '';
                data.episodes.forEach(episode => {
                    const episodeElement = document.createElement('div');
                    episodeElement.innerHTML = `
                        <a data-id="${episode.id}" href="javascript:;" class="ep-item ${episode.id === initialEpisodeId ? 'on-air' : ''}">
                            <div class="is-icon"><i class="fas fa-play"></i></div>
                            <div class="is-info">
                                <span class="number">Episode ${episode.episode_number}</span>
                                <span class="name sum">${episode.name}</span>
                            </div>
                        </a>
                    `;
                    episodesListContainer.appendChild(episodeElement);
                });

                // Update the season dropdown
                currentSeasonElement.textContent = `Season ${seasonNumber}`;

                // Add click event listeners to the new episode items
                document.querySelectorAll('.ep-item').forEach(item => {
                    item.addEventListener('click', () => {
                        const episodeId = item.getAttribute('data-id');
                        const episodeNumber = item.querySelector('.number').textContent.split(' ')[1];
                        updateActiveEpisode(episodeId, episodeNumber, seasonNumber);
                    });
                });

                // Set the first episode of the new season as active
                if (data.episodes.length > 0) {
                    const firstEpisode = data.episodes[0];
                    updateActiveEpisode(firstEpisode.id, firstEpisode.episode_number, seasonNumber);
                }
            })
            .catch(error => {
                console.error('Error fetching season episodes:', error);
            });
    }

    // Add click event listeners to season items
    document.querySelectorAll('.ss-item').forEach(item => {
        item.addEventListener('click', () => {
            const seasonNumber = item.getAttribute('data-id');
            updateSeasonEpisodes(seasonNumber);
        });
    });

    // Add click event listeners to server items
    document.querySelectorAll('.dropdown-item.sv-item').forEach(serverItem => {
        serverItem.addEventListener('click', () => {
            // Remove the active class from all server items
            document.querySelectorAll('.dropdown-item.sv-item').forEach(item => {
                item.classList.remove('active');
                item.querySelector('small.text-active').style.display = 'none';
            });

            // Add the active class to the clicked server item
            serverItem.classList.add('active');
            serverItem.querySelector('small.text-active').style.display = 'inline';

            // Update the current server text
            currentServerElement.textContent = `Server ${serverItem.querySelector('.sv-name').textContent.trim().split(' ')[1]}`;

            // Update the iframe source with the new server URL
            const serverUrl = serverItem.getAttribute('data-url')
                .replace('{episode_id}', initialEpisodeId)
                .replace('{season_number}', initialSeasonNumber)
                .replace('{episode_number}', initialEpisodeNumber)
                .replace('{seriesId}', seriesId);
            iframe.src = serverUrl;
            console.log('Updated iframe source on server change:', serverUrl);
        });
    });

    // Initialize the first episode and server
    updateActiveEpisode(initialEpisodeId, initialEpisodeNumber, initialSeasonNumber);
});

</script>
    <!-- End: Javascript -->
</body>

