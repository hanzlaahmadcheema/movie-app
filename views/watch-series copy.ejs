                                        </a>
                                    </div>
                                </div>
                                <!-- Episodes List -->
                                <div class="eps-list" style="max-height: 660px; overflow-y: auto;">
                                    <div class="eps-wrap no-thumb ps-container" id="ss-episodes-<%= currentSeason.season_number %>">
                                        <% currentSeason.episodes.forEach(episode => { %>
                                            <div>
                                                <a data-id="<%= episode.id %>" href="javascript:;" class="ep-item <%= episode.id === currentEpisode.id ? 'on-air' : '' %>">
                                                    <div class="is-icon"><i class="fas fa-play"></i></div>
                                                    <div class="is-info">
                                                        <span class="number">Episode <%= episode.episode_number %> </span>
                                                        <span class="name sum"><%= episode.name %></span>
                                                    </div>
                                                </a>
                                            </div>
                                        <% }); %>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </section>
            
            
            <section class="section-default section-flow-vertical section-film-list is-carousel">
