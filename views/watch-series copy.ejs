                                            <span id="current-server">Select Server</span><i class="fas fa-angle-down ml-3"></i>
                                        </div>
                                        <div class="dropdown-menu dropdown-primary mine-dropdown" style="max-height: 300px; overflow-y: auto;">
                                            <% servers.forEach(server => { %>
                                                <a class="dropdown-item sv-item <%= server.id === servers[0].id ? 'active' : '' %>" href="javascript:;" data-url="<%= server.url.replace('{episode_id}', currentEpisode.id).replace('{season_number}', currentSeason.season_number).replace('{episode_number}', currentEpisode.episode_number).replace('{seriesId}', series.id) %>">
                                                    <i class="fas fa-cloud is-icon"></i>
                                                    <div class="d-name">
                                                        <div class="sv-name">Server <strong><%= server.name %></strong></div>
                                                        <small class="text-active" style="<%= server.id === servers[0].id ? 'display: inline;' : 'display: none;' %>">Selected</small>
                                                    </div>
                                                </a>
                                            <% }); %>
                                        </div>
                                        <small>If the current server doesn't work, please try other servers above</small>
                                    </div>
                                    <div class="is-func">
                                        <div class="item item-light">
                                            <div id="toggle-light" class="btn w-icon">
                                                <i class="fas fa-adjust mr-2"></i>Toggle light
                                            </div>
                                        </div>
                                        <div class="item item-fav" id="wl-content">
                                            <a href="contact-us.html">
                                                <div class="btn w-icon icon-fav btn-wl">
                                                    <i class="far fa-flag mr-2"></i> Report Video
                                                </div>
                                            </a>
                                        </div>
                                        <div class="item item-comment">
                                            <div class="btn w-icon btn-comment"><i class="fas fa-comment mr-2"></i>Comment</div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div id="eps-list" class="film-episodes backdrop-blur-50">
                                <div class="eps-top">
                                    <!-- Season Dropdown -->
                                    <div class="dropdown is-seasons">
                                        <div class="btn w-icon" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                            <span id="current-ss">Season <%= currentSeason.season_number %></span><i class="fas fa-angle-down ml-3"></i>
                                        </div>
                                        <div class="dropdown-menu dropdown-primary mine-dropdown" style="max-height: 300px; overflow-y: auto;">
                                            <% seasons.forEach(season => { %>
                                                <a data-id="<%= season.season_number %>" class="dropdown-item ss-item <%= season.season_number === currentSeason.season_number ? 'active' : '' %>">
                                                    <i class="fas fa-list is-icon"></i>
                                                    <div class="d-name">
                                                        <div class="ss-name">Season <strong><%= season.season_number %></strong></div>
                                                        <small><%= season.air_date %></small>
                                                    </div>
                                                </a>
                                            <% }); %>
                                        </div>
                                    </div>
                                    <div class="item item-fav" id="wl-content">
                                        <a href="contact-us.html">
                                            <div class="btn w-icon icon-fav btn-wl">
                                                <i class="far fa-flag mr-2"></i> Report Episode
