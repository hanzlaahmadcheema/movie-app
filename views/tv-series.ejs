<body id="gMNrTK">
    <div id="mobile-overlay"></div>
    <div id="menu-display" class="">
        <ul class="nav menu-display-list">
            <li class="nav-item active"><a class="nav-link" href="/" title="Home">Home</a></li>
            <li class="nav-item"><a class="nav-link" href="/movies" title="Movies">Movies</a></li>
            <li class="nav-item"><a class="nav-link" href="/tv-series" title="TV Series">TV Series</a></li>
            <li class="nav-item"><a class="nav-link" href="/contact-us" title="Contact Us">Contact Us</a></li>
        </ul>
    </div>
    <div id="app">
        <!--/// Header ///-->
        <header class="">
            <div class="container">
                <div id="header_elements">
                    <div class="btn btn-touch mobile-button" id="mobile_menu"><i class="fas fa-bars"></i></div>
                    <a href="/" id="header_logo">
                        <img src="/images/logo.png" alt="HA Entertainment">
                    </a>
                    <div id="header_search">
                        <div class="search-elements">
                            <form id="search-form" action="/search" method="GET">
                                <div class="search-submit">
                                    <div class="search-icon"><i class="fa fa-search"></i></div>
                                </div>
                                <input name="keyword" type="text" id="search-input" class="form-control is-input"
                                    placeholder="Search for movies or TV series" />
                            </form>
                            <div id="search-suggestions" class="is-result search-suggest" style="display: none;">
                            </div>
                        </div>
                    </div>
                    <div id="header_menu">
                        <div class="menu-item">
                            <a href="/" class="menu-link ">Home</a>
                        </div>
                        <div class="menu-item">
                            <a href="/movies" class="menu-link">Movies</a>
                        </div>
                        <div class="menu-item">
                            <a href="/tv-series" class="menu-link active">TV Series</a>
                        </div>

                        <div class="menu-item">
                            <a href="/contact-us" class="menu-link ">Contact Us</a>
                        </div>
                    </div>
                    <div class="flex-grow"></div>
                    <div class="btn btn-touch mobile-button" id="mobile_search"><i class="fas fa-search"></i></div>
                </div>
            </div>
        </header>
        <!--/// Page body ///-->
        <div id="page-detail">
            <!-- All Movies Section -->
            <section class="section-default section-flow-vertical section-page section-film-list is-head-cate is-list">
                <div class="container">
                    <div class="section-header">
                        <div class="is-title">
                            <h2 class="heading-md">All TV Series</h2>
                        </div>
                        <div class="flex-grow"></div>
                    </div>
                    <div class="section-body">
                        <div class="film-list">
                            <% tvSeries.forEach(series=> { %>
                                <div class="item-film">
                                    <a href="/watch-series/<%= series.id %>" class="film-mask"></a>
                                    <div class="film-thumbnail">
                                        <div class="badge-tag quality">HD</div>
                                        <img class="film-thumbnail-img"
                                            src="https://image.tmdb.org/t/p/w342<%= series.poster_path %>"
                                            alt="<%= series.name %>">
                                    </div>
                                    <div class="film-detail">
                                        <h3 class="film-name sum-2">
                                            <a href="/watch-series/<%= series.id %>" title="<%= series.name %>">
                                                <%= series.name %>
                                            </a>
                                        </h3>
                                        <div class="film-info">
                                            <span class="item">TV Series</span>
                                            <span class="item">
                                                <%= new Date(series.release_date).getFullYear() %>
                                            </span>
                                        </div>
                                    </div>
                                </div>
                                <% }); %>
                        </div>

                        <% if (totalPages> 1) { %>
                            <div class="section-pagination">
                                <nav aria-label="Page navigation">
                                    <ul class="pagination justify-content-center mb-0">
                                        <% if (currentPage> 1) { %>
                                            <li class="page-item">
                                                <a class="page-link" href="?page=1" aria-label="First">
                                                    <span aria-hidden="true"><i
                                                            class="fa fa-angle-double-left"></i></span>
                                                    <span class="sr-only">First</span>
                                                </a>
                                            </li>
                                            <li class="page-item">
                                                <a class="page-link" href="?page=<%= currentPage - 1 %>"
                                                    aria-label="Previous">
                                                    <span aria-hidden="true"><i class="fa fa-angle-left"></i></span>
                                                    <span class="sr-only">Previous</span>
                                                </a>
                                            </li>
                                            <% } %>

                                                <% const maxPagesToShow=3; // Define the number of page links to show
                                                    const startPage=Math.max(1, currentPage - Math.floor(maxPagesToShow
                                                    / 2)); const endPage=Math.min(500, startPage + maxPagesToShow - 1);
                                                    for (let i=startPage; i <=endPage; i++) { %>
                                                    <li class="page-item <%= i === currentPage ? 'active' : '' %>">
                                                        <a class="page-link" href="?page=<%= i %>">
                                                            <%= i %>
                                                        </a>
                                                    </li>
                                                    <% } %>

                                                        <% if (currentPage < 500) { %>
                                                            <li class="page-item">
                                                                <a class="page-link" href="?page=<%= currentPage + 1 %>"
                                                                    aria-label="Next">
                                                                    <span aria-hidden="true"><i
                                                                            class="fa fa-angle-right"></i></span>
                                                                    <span class="sr-only">Next</span>
                                                                </a>
                                                            </li>
                                                            <li class="page-item">
                                                                <a class="page-link" href="?page=<%= 500 %>"
                                                                    aria-label="Last">
                                                                    <span aria-hidden="true"><i
                                                                            class="fa fa-angle-double-right"></i></span>
                                                                    <span class="sr-only">Last</span>
                                                                </a>
                                                            </li>
                                                            <% } %>
                                    </ul>
                                </nav>
                            </div>
                            <% } %>
                    </div>
                </div>
            </section>
        </div>
        <!-- Footer Section -->
        <div class="flex-grow"></div>
        <footer>
            <div class="footer-top">
                <div class="container">
                    <div class="d-flex footer-elements">
                        <div class="footer-logo">
                            <a href="/" class="is-logo"><img src="/images/logo.png" alt="HA Entertainment"></a>
                        </div>
                        <div class="footer-about">
                            <div class="heading-sm mb-3">About Us</div>
                            <p>HA Entertainment is free tv shows streaming website with zero ads, it
                                allows you <strong>watch tv shows online</strong>, <strong>watch tv shows online
                                    free</strong>
                                in high quality for free.
                            </p>
                            <small>This site does not store any files on our server, we only linked to the media which
                                is hosted
                                on 3rd party services.</small>
                            <div class="links pt-5">
                                <a href="/sitemap.xml">Sitemap</a>
                                <a href="/contact-us">Contact</a>
                                <a href="/terms">Terms of service</a>
                                <br>
                                <a href="https://turkish.ha-entertainment.com/">Turkish Series (Urdu Subtitle & Urdu Dubbing)</a>

                            </div>
                        </div>
                        <div class="footer-menu">
                            <div class="heading-sm mb-3">Links</div>
                            <div class="d-flex">
                                <ul class="style-none">
                                    <li><a href="/movies">Movies</a></li>
                                    <li><a href="/tv-series">TV Series</a></li>
                                    
                                </ul>
                            </div>
                        </div>
                        <div class="flex-grow"></div>
                        <div class="footer-up">
                            <a href="#app" class="btn btn-lg btn-light w-icon linknav"><i
                                    class="fas fa-angle-up mr-2"></i><strong>Top</strong></a>
                        </div>
                    </div>
                </div>
            </div>
        </footer>
    </div>
    <!-- Begin: Scripts -->
    <script src="https://code.jquery.com/jquery-3.3.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.1.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/app.min.js"></script>
    <script src="/js/search.js"></script>
    
  
    <!-- End: Scripts -->
</body>

</html>