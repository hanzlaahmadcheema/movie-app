        content="Explore the latest and trending TV series on HA Entertainment. Stream and enjoy a wide selection of TV shows in Full HD quality, all for free!">
    <meta name="twitter:image" content="https://www.ha-entertainment.com/images/logo.png">

    <!-- Stylesheets -->
    <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/4.1.3/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://use.fontawesome.com/releases/v5.3.1/css/all.css">
    <link rel="stylesheet" href="/css/theme_1.css">

