<!DOCTYPE html>
<html lang="en">

<head>
    <title><%= cast.name %> - Full Profile - HA Entertainment</title>

    <!-- Meta Tags -->
    <meta charset="UTF-8">
    <meta name="robots" content="index, follow">
    <meta http-equiv="content-language" content="en" />
    <meta name="description" content="<%= cast.name %>'s profile, including filmography and biography. Discover their roles and achievements on HA Entertainment." />
    <meta name="keywords" content="<%= cast.name %> profile, actor biography, filmography, HA Entertainment" />
    <meta name="viewport" content="width=device-width, initial-scale=1, minimum-scale=1, maximum-scale=1" />

    <!-- Canonical Link -->
    <link rel="canonical" href="https://ha-entertainment.vercel.app/cast/<%= cast.id %>" />

    <!-- Favicon and Icons -->
    <link rel="shortcut icon" href="https://ha-entertainment.vercel.app/images/logo.png" type="image/x-icon" />
    <link rel="icon" type="image/png" sizes="32x32" href="https://ha-entertainment.vercel.app/images/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="https://ha-entertainment.vercel.app/images/favicon-16x16.png">
    <link rel="apple-touch-icon" sizes="180x180" href="https://ha-entertainment.vercel.app/images/apple-touch-icon.png">

    <!-- Open Graph Meta Tags -->
    <meta property="og:type" content="profile" />
    <meta property="og:title" content="<%= cast.name %> - Full Profile on HA Entertainment" />
    <meta property="og:url" content="https://ha-entertainment.vercel.app/cast/<%= cast.id %>" />
    <meta property="og:image" content="https://image.tmdb.org/t/p/original<%= cast.profile_path %>" />
    <meta property="og:image:width" content="500">
    <meta property="og:image:height" content="750">
    <meta property="og:description" content="<%= cast.name %>'s profile, including filmography and biography. Discover their roles and achievements on HA Entertainment." />
    <meta property="og:site_name" content="HA Entertainment" />

    <!-- Twitter Card Meta Tags -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:site" content="@HA_Entertainment">
    <meta name="twitter:title" content="<%= cast.name %> - Full Profile on HA Entertainment">
    <meta name="twitter:description" content="<%= cast.name %>'s profile, including filmography and biography. Discover their roles and achievements on HA Entertainment.">
    <meta name="twitter:image" content="https://image.tmdb.org/t/p/original<%= cast.profile_path %>">

    <!-- Stylesheets -->
    <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/4.1.3/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://use.fontawesome.com/releases/v5.3.1/css/all.css">
    <link rel="stylesheet" href="/css/theme_1.css">

    <!-- Schema Markup for Cast Profile Page -->
    <script type="application/ld+json">
        {
          "@context": "https://schema.org",
          "@type": "Person",
          "name": "<%= cast.name %>",
          "url": "https://ha-entertainment.vercel.app/cast/<%= cast.id %>",
          "image": "https://image.tmdb.org/t/p/original<%= cast.profile_path %>",
          "description": "<%= cast.biography %>",
          "birthDate": "<%= cast.birthday %>",
          "birthPlace": "<%= cast.place_of_birth %>",
          "filmography": [
            <% if (cast.movies && cast.movies.length > 0) { %>
              <% cast.movies.forEach((movie, index) => { %>
                {
                  "@type": "Movie",
                  "name": "<%= movie.title %>",
                  "url": "https://ha-entertainment.vercel.app/movie/<%= movie.id %>"
                }<% if (index < cast.movies.length - 1) { %>,<% } %>
              <% }) %>
            <% } %>
          ]
        }
    </script>

    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-VS8TC16J1Q"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-VS8TC16J1Q');
    </script>
</head>


<body id="gMNrTK">
