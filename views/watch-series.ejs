    <link rel="apple-touch-icon" sizes="180x180" href="https://ha-entertainment.com/images/apple-touch-icon.png">

    <!-- Open Graph Meta Tags -->
    <meta property="og:type" content="video.episode" />
    <meta property="og:title" content="Watch <%= series.name %> - Season <%= selectedSeason %> Episode <%= currentEpisode.episode_number %> - Free Full HD Streaming" />
    <meta property="og:url" content="https://ha-entertainment.com/watch-series/<%= series.id %>/season/<%= selectedSeason %>/episode/<%= currentEpisode.episode_number %>" />
    <meta property="og:image" content="https://image.tmdb.org/t/p/w780<%= series.backdrop_path %>" />
    <meta property="og:image:width" content="500">
    <meta property="og:image:height" content="750">
    <meta property="og:description" content="Watch <%= series.name %> Season <%= selectedSeason %> Episode <%= currentEpisode.episode_number %> in Full HD for free on HA Entertainment. Stream without ads and enjoy the best quality." />
    <meta property="og:site_name" content="HA Entertainment" />
    <meta property="og:video" content="https://multiembed.mov/?video_id=<%= series.id %>&tmdb=1&s=<%= selectedSeason %>&e=<%= currentEpisode.episode_number %>" />

    <!-- Twitter Card Meta Tags -->
