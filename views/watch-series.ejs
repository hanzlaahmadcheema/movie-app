    <script>
$(document).ready(function() {
    const seriesId = '<%= series.id %>'; // Pass series ID to the script

    // Get URL parameters from path
    const pathParts = window.location.pathname.split('/');
    const season = pathParts[4] || 1;
    const episode = pathParts[6] || 1;

    // Set the current season and episode
    $('#current-ss').text('Season ' + season);
    $('.ss-item').removeClass('active');
    $(`.ss-item[data-id="${season}"]`).addClass('active');

    $('.ep-item').removeClass('on-air');
    $(`.ep-item[data-id="${episode}"]`).addClass('on-air');

    // Update server URL based on episode
    $('.sv-item').each(function() {
        const serverUrl = $(this).data('url');
        const newServerUrl = serverUrl.replace(/season=\d+/, `season=${season}`).replace(/episode=\d+/, `episode=${episode}`);
        $(this).data('url', newServerUrl);
    });

    // Handle server dropdown change
    $('.sv-item').click(function() {
        var url = $(this).data('url');
        $('#iframe-player').attr('src', url);
        $('#current-server').text($(this).find('.sv-name strong').text());
        $('.sv-item').removeClass('active');
        $('.sv-item .text-active').hide();
        $(this).addClass('active');
        $(this).find('.text-active').show();
    });

    // Handle season dropdown change
    $('.ss-item').click(function() {
        var seasonNumber = $(this).data('id');
        var currentEpisodeId = $('.ep-item.on-air').data('id');
        window.location.href = `/watch-series/${seriesId}/season/${seasonNumber}/episode/${currentEpisodeId}`;
    });

    // Handle episode change
    $('.ep-item').click(function() {
        var episodeNumber = $(this).data('id');
        // Redirect to the URL for the selected episode
        window.location.href = `/watch-series/${seriesId}/season/${season}/episode/${episodeNumber}`;
    });
});


    </script>
