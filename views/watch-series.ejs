    <meta name="description" content="<%= series.overview %> - Watch <%= series.name %> Season <%= selectedSeason %> Episode <%= currentEpisode.episode_number %> in Full HD for free on HA Entertainment. Stream without ads and enjoy the best quality." />
    <meta name="keywords" content="watch <%= series.name %> ha entertainment, watch <%= series.name %> online ha entertainment, watch <%= series.name %> free ha entertainment, watch <%= series.name %>, watch <%= series.name %>, free TV series streaming, HD TV shows, <%= series.name %> Season <%= selectedSeason %>, Episode <%= currentEpisode.episode_number %>, free TV series online, watch TV shows without ads" />
    <meta name="viewport" content="width=device-width, initial-scale=1, minimum-scale=1, maximum-scale=1" />

    <!-- Canonical Link -->
    <link rel="canonical" href="https://ha-entertainment.com/watch-series/<%= series.id %>/season/<%= selectedSeason %>/episode/<%= currentEpisode.episode_number %>" />

    <!-- Favicon and Icons -->
