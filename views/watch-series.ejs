    <meta name="twitter:site" content="@HA_Entertainment">
    <meta name="twitter:title" content="Watch <%= series.name %> - Season <%= selectedSeason %> Episode <%= currentEpisode.episode_number %> - Free Full HD Streaming">
    <meta name="twitter:description" content="Watch <%= series.name %> Season <%= selectedSeason %> Episode <%= currentEpisode.episode_number %> in Full HD for free on HA Entertainment. Stream without ads and enjoy the best quality.">
    <meta name="twitter:image" content="https://image.tmdb.org/t/p/w780<%= series.backdrop_path %>">
    <meta name="twitter:player" content="https://multiembed.mov/?video_id=<%= series.id %>&tmdb=1&s=<%= selectedSeason %>&e=<%= currentEpisode.episode_number %>">

    <!-- Stylesheets -->
    <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/4.1.3/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://use.fontawesome.com/releases/v5.3.1/css/all.css">
    <link rel="stylesheet" href="/css/theme_1.css">

    <!-- Schema Markup for TV Series Watching Page -->
    <script type="application/ld+json">
        {
          "@context": "https://schema.org",
          "@type": "TVSeries",
          "name": "<%= series.name %>",
          "url": "https://ha-entertainment.com/watch-series/<%= series.id %>/season/<%= selectedSeason %>/episode/<%= currentEpisode.episode_number %>",
          "description": "<%= series.overview %>",
          "image": "https://image.tmdb.org/t/p/w780<%= series.backdrop_path %>",
          "genre": [
            <% if (series.genres && series.genres.length > 0) { %>
              <% series.genres.forEach((genre, index) => { %>
                "<%= genre.name %>"<% if (index < series.genres.length - 1) { %>,<% } %>
              <% }) %>
            <% } else { %>
              "Unknown"
            <% } %>
          ],
          "episode": [
            <% if (episodes && episodes.length > 0) { %>
              <% episodes.forEach((episode, index) => { %>
                {
                  "@type": "Episode",
                  "episodeNumber": "<%= episode.episode_number %>",
                  "name": "<%= episode.name %>",
                  "url": "https://ha-entertainment.com/watch-series/<%= series.id %>/season/<%= selectedSeason %>/episode/<%= episode.episode_number %>"
                }<% if (index < episodes.length - 1) { %>,<% } %>
              <% }) %>
            <% } %>
          ],
          "season": {
            "@type": "TVSeason",
            "seasonNumber": "<%= selectedSeason %>"
          },
          "video": {
            "@type": "VideoObject",
            "name": "<%= series.name %> Season <%= selectedSeason %> Episode <%= currentEpisode.episode_number %>",
            "description": "<%= series.overview %>",
            "contentUrl": "https://multiembed.mov/?video_id=<%= series.id %>&tmdb=1&s=<%= selectedSeason %>&e=<%= currentEpisode.episode_number %>",
            "thumbnailUrl": "https://image.tmdb.org/t/p/w780<%= series.backdrop_path %>",
            "embedUrl": "https://multiembed.mov/?video_id=<%= series.id %>&tmdb=1&s=<%= selectedSeason %>&e=<%= currentEpisode.episode_number %>",
            "uploadDate": "<%= series.first_air_date %>T08:00:00+08:00"
          }
        }
    </script>

