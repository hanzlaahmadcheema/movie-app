<!DOCTYPE html>
<html lang="en">

<head>
    <title>Watch <%= series.name %> - Season <%= selectedSeason %> - Episode <%= currentEpisode.episode_number %> - Free Full HD Streaming - H.A Entertainment</title>

    <!-- Meta Tags -->
    <meta charset="UTF-8">
    <meta name="robots" content="index, follow">
    <meta http-equiv="content-language" content="en" />
    <meta name="description" content="Watch <%= series.name %> Season <%= selectedSeason %> Episode <%= currentEpisode.episode_number %> in Full HD for free on H.A Entertainment. Stream without ads and enjoy the best quality." />
    <meta name="keywords" content="watch <%= series.name %>, free TV series streaming, HD TV shows, <%= series.name %> Season <%= selectedSeason %>, Episode <%= currentEpisode.episode_number %>, free TV series online, watch TV shows without ads" />
    <meta name="viewport" content="width=device-width, initial-scale=1, minimum-scale=1, maximum-scale=1" />

    <!-- Canonical Link -->
    <link rel="canonical" href="https://ha-entertainment.vercel.app/watch-series/<%= series.id %>/season/<%= selectedSeason %>/episode/<%= currentEpisode.episode_number %>" />

    <!-- Favicon and Icons -->
    <link rel="shortcut icon" href="https://ha-entertainment.vercel.app/images/logo.png" type="image/x-icon" />
    <link rel="icon" type="image/png" sizes="32x32" href="https://ha-entertainment.vercel.app/images/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="https://ha-entertainment.vercel.app/images/favicon-16x16.png">
    <link rel="apple-touch-icon" sizes="180x180" href="https://ha-entertainment.vercel.app/images/apple-touch-icon.png">

    <!-- Open Graph Meta Tags -->
    <meta property="og:type" content="video.episode" />
    <meta property="og:title" content="Watch <%= series.name %> - Season <%= selectedSeason %> Episode <%= currentEpisode.episode_number %> - Free Full HD Streaming" />
    <meta property="og:url" content="https://ha-entertainment.vercel.app/watch-series/<%= series.id %>/season/<%= selectedSeason %>/episode/<%= currentEpisode.episode_number %>" />
    <meta property="og:image" content="https://image.tmdb.org/t/p/original<%= series.backdrop_path %>" />
    <meta property="og:image:width" content="500">
    <meta property="og:image:height" content="750">
    <meta property="og:description" content="Watch <%= series.name %> Season <%= selectedSeason %> Episode <%= currentEpisode.episode_number %> in Full HD for free on H.A Entertainment. Stream without ads and enjoy the best quality." />
    <meta property="og:site_name" content="H.A Entertainment" />
    <meta property="og:video" content="<%= servers[0].url %>" />

    <!-- Twitter Card Meta Tags -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:site" content="@HA_Entertainment">
    <meta name="twitter:title" content="Watch <%= series.name %> - Season <%= selectedSeason %> Episode <%= currentEpisode.episode_number %> - Free Full HD Streaming">
    <meta name="twitter:description" content="Watch <%= series.name %> Season <%= selectedSeason %> Episode <%= currentEpisode.episode_number %> in Full HD for free on H.A Entertainment. Stream without ads and enjoy the best quality.">
    <meta name="twitter:image" content="https://image.tmdb.org/t/p/original<%= series.backdrop_path %>">
    <meta name="twitter:player" content="<%= servers[0].url %>">

    <!-- Stylesheets -->
    <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/4.1.3/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://use.fontawesome.com/releases/v5.3.1/css/all.css">
    <link rel="stylesheet" href="/css/theme_1.css">

    <!-- Schema Markup for TV Series Watching Page -->
    <script type="application/ld+json">
        {
          "@context": "https://schema.org",
          "@type": "TVSeries",
          "name": "<%= series.name %>",
          "url": "https://ha-entertainment.vercel.app/watch-series/<%= series.id %>/season/<%= selectedSeason %>/episode/<%= currentEpisode.episode_number %>",
          "description": "<%= series.overview %>",
          "image": "https://image.tmdb.org/t/p/original<%= series.backdrop_path %>",
          "genre": [
            <% if (series.genres && series.genres.length > 0) { %>
              <% series.genres.forEach((genre, index) => { %>
                "<%= genre.name %>"<% if (index < series.genres.length - 1) { %>,<% } %>
              <% }) %>
            <% } else { %>
              "Unknown"
            <% } %>
          ],
          "episode": [
            <% if (episodes && episodes.length > 0) { %>
              <% episodes.forEach((episode, index) => { %>
                {
                  "@type": "Episode",
                  "episodeNumber": "<%= episode.episode_number %>",
                  "name": "<%= episode.name %>",
                  "url": "https://ha-entertainment.vercel.app/watch-series/<%= series.id %>/season/<%= selectedSeason %>/episode/<%= episode.episode_number %>"
                }<% if (index < episodes.length - 1) { %>,<% } %>
              <% }) %>
            <% } %>
          ],
          "season": {
            "@type": "TVSeason",
            "seasonNumber": "<%= selectedSeason %>"
          },
          "video": {
            "@type": "VideoObject",
            "name": "<%= series.name %> Season <%= selectedSeason %> Episode <%= currentEpisode.episode_number %>",
            "description": "<%= series.overview %>",
            "contentUrl": "<%= servers[0].url %>",
            "thumbnailUrl": "https://image.tmdb.org/t/p/original<%= series.backdrop_path %>",
            "embedUrl": "<%= servers[0].url %>",
            "uploadDate": "<%= series.first_air_date %>T08:00:00+08:00"
          }
        }
    </script>

    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-VS8TC16J1Q"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-VS8TC16J1Q');
    </script>
</head>


