<!DOCTYPE html>
<html lang="en">

<head>
    <title>Search Results for <%= searchName %> - HA Entertainment</title>

    <!-- Meta Tags -->
    <meta charset="UTF-8">
    <meta name="robots" content="index, follow">
    <meta http-equiv="content-language" content="en" />
    <meta name="description" content="Find the best movies, TV series, and more related to <%= searchName %> on HA Entertainment. Stream without ads and enjoy high quality." />
    <meta name="keywords" content="search <%= searchName %>, movies search, TV series search, find movies, find TV shows, HA Entertainment" />
    <meta name="viewport" content="width=device-width, initial-scale=1, minimum-scale=1, maximum-scale=1" />

    <!-- Canonical Link -->
    <link rel="canonical" href="https://ha-entertainment.com/search/<%= encodeURIComponent(keyword) %>" />

    <!-- Favicon and Icons -->
    <link rel="shortcut icon" href="https://ha-entertainment.com/images/logo.png" type="image/x-icon" />
    <link rel="icon" type="image/png" sizes="32x32" href="https://ha-entertainment.com/images/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="https://ha-entertainment.com/images/favicon-16x16.png">
    <link rel="apple-touch-icon" sizes="180x180" href="https://ha-entertainment.com/images/apple-touch-icon.png">

    <!-- Open Graph Meta Tags -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content="Search Results for <%= searchName %> - HA Entertainment" />
    <meta property="og:url" content="https://ha-entertainment.com/search/<%= encodeURIComponent(keyword) %>" />
    <meta property="og:image" content="<%= imageUrl %>" />
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:description" content="Find the best movies, TV series, and more related to <%= searchName %> on HA Entertainment. Stream without ads and enjoy high quality." />
    <meta property="og:site_name" content="HA Entertainment" />

    <!-- Twitter Card Meta Tags -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:site" content="@HA_Entertainment">
    <meta name="twitter:title" content="Search Results for <%= searchName %> - HA Entertainment">
    <meta name="twitter:description" content="Find the best movies, TV series, and more related to <%= searchName %> on HA Entertainment.">
    <meta name="twitter:image" content="<%= imageUrl %>">

    <!-- Stylesheets -->
    <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/4.1.3/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://use.fontawesome.com/releases/v5.3.1/css/all.css">
    <link rel="stylesheet" href="/css/theme_1.css">

    <!-- Schema Markup for Search Results Page -->
    <script type="application/ld+json">
        {
          "@context": "https://schema.org",
          "@type": "SearchResultsPage",
          "name": "Search Results for <%= searchName %>",
          "url": "https://ha-entertainment.com/search/<%= encodeURIComponent(keyword) %>",
          "description": "Find movies, TV series, and more related to <%= searchName %> on HA Entertainment.",
          "image": "<%= imageUrl %>"
        },
        "potentialAction": {
            "@type": "SearchAction",
            "target": "https://ha-entertainment.com/search?keyword={search_term_string}",
            "query-input": "required name=search_term_string"
          }
    </script>

    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-VS8TC16J1Q"></script>
    <script>
