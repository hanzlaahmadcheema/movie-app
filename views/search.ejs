                    <div class="btn btn-touch mobile-button" id="mobile_search"><i class="fas fa-search"></i></div>
                </div>
            </div>
        </header>
        <!--/// Page body ///-->
        <div id="page-category">
            <!-- Search Detail Section -->
            <section class="section-default section-flow-vertical section-page section-film-list is-head-cate is-list">
                <div class="container">
                    <div class="section-header">
                        <div class="is-title">
                            <h2 class="heading-md">Search results for <%= searchName %></h2>
                        </div>
                        <div class="flex-grow"></div>
                    </div>
                    <div class="section-body">
                        <% if (combinedResults.length > 0) { %>
                            <div class="film-list">
                                <% combinedResults.forEach(item => { %>
                                    <div class="item-film">
                                        <a href="<%= item.media_type === 'movie' ? '/movie/' + item.id : item.media_type === 'tv' ? '/series/' + item.id : '/cast/' + item.id %>" class="film-mask"></a>
                                        <div class="film-thumbnail">
                                            <div class="badge-tag quality">HD</div>
                                            <img class="film-thumbnail-img" 
                                                src="<%= item.media_type === 'person' && item.profile_path ? 'https://image.tmdb.org/t/p/w185' + item.profile_path : 'https://image.tmdb.org/t/p/w185' + (item.poster_path || '') %>" 
                                                alt="<%= item.title || item.name %>" 
                                                onerror="this.onerror=null;this.src='https://ha-entertainment.com/images/header.jpg';">
                                        </div>
                                        <div class="film-detail">
                                            <h3 class="film-name sum-2">
                                                <a href="<%= item.media_type === 'movie' ? '/movie/' + item.id : item.media_type === 'tv' ? '/series/' + item.id : '/cast/' + item.id %>" title="<%= item.title || item.name %>"><%= item.title || item.name %></a>
                                            </h3>
                                            <div class="film-info">
                                                <% if (item.media_type === 'movie' || item.media_type === 'tv') { %>
                                                    <span class="item"><%= item.media_type === 'movie' ? 'Movie' : 'TV Series' %></span>
                                                    <span class="item"><%= item.release_date ? new Date(item.release_date).getFullYear() : new Date(item.first_air_date).getFullYear() %></span>
                                                <% } else if (item.media_type === 'person') { %>
                                                    <span class="item">Person</span>
                                                    <span class="item"><%= item.gender === 1 ? 'Female' : item.gender === 2 ? 'Male' : 'N/A' %></span>
                                                <% } %>
                                            </div>
                                        </div>
                                    </div>
                                <% }); %>
                            </div>
                            
                            <% if (totalPages > 1) { %>
                                <div class="section-pagination">
                                    <nav aria-label="Page navigation">
                                        <ul class="pagination justify-content-center mb-0">
                                            <% if (currentPage > 1) { %>
                                                <li class="page-item">
                                                    <a class="page-link" href="?keyword=<%= encodeURIComponent(keyword) %>&page=<%= 1 %>" aria-label="First">
                                                        <span aria-hidden="true"><i class="fa fa-angle-double-left"></i></span>
                                                        <span class="sr-only">First</span>
                                                    </a>
                                                </li>
                                                <li class="page-item">
                                                    <a class="page-link" href="?keyword=<%= encodeURIComponent(keyword) %>&page=<%= currentPage - 1 %>" aria-label="Previous">
                                                        <span aria-hidden="true"><i class="fa fa-angle-left"></i></span>
                                                        <span class="sr-only">Previous</span>
                                                    </a>
                                                </li>
                                            <% } %>
                    
                                            <% 
                                            const maxPagesToShow = 3;
                                            const startPage = Math.max(1, Math.min(currentPage - Math.floor(maxPagesToShow / 2), totalPages - maxPagesToShow + 1));
                                            const endPage = Math.min(totalPages, startPage + maxPagesToShow - 1);
                    
                                            for (let i = startPage; i <= endPage; i++) { %>
                                                <li class="page-item <%= i === currentPage ? 'active' : '' %>">
                                                    <a class="page-link" href="?keyword=<%= encodeURIComponent(keyword) %>&page=<%= i %>"><%= i %></a>
                                                </li>
                                            <% } %>
                    
                                            <% if (currentPage < totalPages) { %>
                                                <li class="page-item">
                                                    <a class="page-link" href="?keyword=<%= encodeURIComponent(keyword) %>&page=<%= currentPage + 1 %>" aria-label="Next">
                                                        <span aria-hidden="true"><i class="fa fa-angle-right"></i></span>
                                                        <span class="sr-only">Next</span>
                                                    </a>
                                                </li>
                                                <li class="page-item">
                                                    <a class="page-link" href="?keyword=<%= encodeURIComponent(keyword) %>&page=<%= totalPages %>" aria-label="Last">
                                                        <span aria-hidden="true"><i class="fa fa-angle-double-right"></i></span>
                                                        <span class="sr-only">Last</span>
                                                    </a>
                                                </li>
                                            <% } %>
                                        </ul>
                                    </nav>
                                </div>
                            <% } %>
                    
                        <% } else { %>
                            <div class="no-results">
                                <h4>No results found for "<%= keyword %>". Please try a different search term.</h4>
                                <!--Image in center of page-->
                                <img style="display: block; margin-left: auto; margin-right: auto" src="https://media.baamboozle.com/uploads/images/58256/10fa5f91-ab0f-4329-94e1-abc705205227.gif" alt="" width="200"height="200" >
                            </div>
                        <% } %>
                    </div>
                    
                </div>
            </section>
