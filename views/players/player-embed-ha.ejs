<!DOCTYPE html>
<html lang="en">

<head>
    <title><%= title %></title>
    <!-- Meta Tags -->
    <meta charset="UTF-8">
    <meta name="robots" content="noindex">
    <meta http-equiv="content-language" content="en" />
    <meta name="description"
        content="<%= title %> in Full HD for free on HA Entertainment." />
    <meta name="keywords" content="" />
    <meta name="viewport" content="width=device-width, initial-scale=1, minimum-scale=1, maximum-scale=1" />

    <!-- Canonical Link -->
    <% if (typeof contentType !== 'undefined' && contentType === 'movie') { %>
        <link rel="canonical" href="<%= typeof domain !== 'undefined' ? domain : '' %>/player/<%= tmdbId %>" />
    <% } else if (typeof contentType !== 'undefined' && contentType === 'tv') { %>
        <link rel="canonical" href="<%= typeof domain !== 'undefined' ? domain : '' %>/player/<%= tmdbId %>/season/<%= season %>/episode/<%= episode %>" />
    <% } else { %>
        <link rel="canonical" href="<%= typeof domain !== 'undefined' ? domain : '' %>/player/<%= tmdbId %>" />
    <% } %>

    <!-- Favicon and Icons -->
    <link rel="shortcut icon" href="<%= domain %>/images/logo.png" type="image/x-icon" />
    <link rel="icon" type="image/png" sizes="32x32"
        href="<%= domain %>/images/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16"
        href="<%= domain %>/images/favicon-16x16.png">
    <link rel="apple-touch-icon" sizes="180x180"
        href="<%= domain %>/images/apple-touch-icon.png">

    <!-- Open Graph Meta Tags -->
    <meta property="og:type" content="video.episode" />
    <meta property="og:title"
        content="<%= title %> Free Full HD Streaming" />
    <meta property="og:url"
        content="<%= domain %>/watch-series/<%= seriesId %>/season/<%= season %>/episode/<%= episode %>" />
    <meta property="og:image"
        content="<%= domain %>/imageseps/<%= seriesId %>/season/<%= season %>/episode/<%= episode %>.jpg" />
    <meta property="og:description"
        content="<%= title %> in Full HD for free on HA Entertainment." />
    <meta property="og:site_name" content="HA Entertainment" />
    <meta property="og:video"
        content="<%= domain %>/player-embed-ha/<%= seriesId %>/season/<%= season %>/episode/<%= episode %>" />

    <!-- Twitter Card Meta Tags -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:site" content="@HA_Entertainment">
    <meta name="twitter:title"
        content="<%= title %> - Free Full HD Streaming">
    <meta name="twitter:description"
        content="<%= title %> in Full HD for free on HA Entertainment.">
    <meta name="twitter:image"
        content="<%= domain %>/imageseps/<%= seriesId %>/season/<%= season %>/episode/<%= episode %>.jpg">
    <meta name="twitter:player"
        content="<%= domain %>/player-embed-ha/<%= seriesId %>/season/<%= season %>/episode/<%= episode %>">

    <!-- Stylesheets -->
    <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/4.1.3/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://use.fontawesome.com/releases/v5.3.1/css/all.css">
    <link rel="stylesheet" href="/css/theme_1.css">
    <!-- Playerjs Script -->
    <script src="/js/playerjs.js" type="text/javascript"></script>

    <!-- CSS to Adjust Player in Full Page -->
    <style>
        html,
        body {
            margin: 0;
            padding: 0;
            width: 100%;
            height: 100%;
            overflow: hidden;
            /* Prevents scrolling */
        }

        #player-container {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            /* Full height */
            background-color: black;
            /* Optional: Black background behind the video */
            overflow: hidden;
            /* Hide overflow */
        }

        #player {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            /* Full height */
        }

        /* Resume Modal Styles */
        .resume-modal {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-color: rgba(0, 0, 0, 0.8);
            backdrop-filter: blur(15px);
            -webkit-backdrop-filter: blur(15px);
            display: none;
            justify-content: center;
            align-items: center;
            z-index: 9999;
        }

        .resume-modal.show {
            display: flex;
        }

        .resume-modal-content {
            background-color: rgba(19, 19, 21, 0.95);
            border-radius: 12px;
            padding: 2rem;
            max-width: 450px;
            width: 90%;
            text-align: center;
            position: relative;
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.5);
            animation: modalSlideUp 0.3s ease-out;
        }

        @keyframes modalSlideUp {
            from {
                opacity: 0;
                transform: translateY(30px) scale(0.95);
            }
            to {
                opacity: 1;
                transform: translateY(0) scale(1);
            }
        }

        .resume-modal-title {
            font-size: 1.5em;
            font-weight: 700;
            color: #fff;
            margin-bottom: 1rem;
        }

        .resume-modal-message {
            color: #ccc;
            margin-bottom: 1.5rem;
            line-height: 1.5;
        }

        .resume-modal-time {
            color: #ea5dff;
            font-weight: 600;
            font-size: 1.1em;
        }

        .resume-modal-buttons {
            display: flex;
            gap: 1rem;
            justify-content: center;
        }

        .resume-btn {
            padding: 0.75rem 1.5rem;
            border: none;
            border-radius: 6px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.2s ease;
            font-size: 0.95em;
        }

        .resume-btn-primary {
            background: linear-gradient(135deg, #ea5dff, #d946ef);
            color: #fff;
        }

        .resume-btn-primary:hover {
            background: linear-gradient(135deg, #d946ef, #c026d3);
            transform: translateY(-2px);
        }

        .resume-btn-secondary {
            background: rgba(255, 255, 255, 0.1);
            color: #ccc;
            border: 1px solid rgba(255, 255, 255, 0.2);
        }

        .resume-btn-secondary:hover {
            background: rgba(255, 255, 255, 0.2);
            color: #fff;
        }
    </style>
</head>

<body>
    <!-- Player Container -->
    <div id="player-container">
        <div id="player"></div>
    </div>

    <!-- Resume Modal -->
    <div id="resumeModal" class="resume-modal">
        <div class="resume-modal-content">
            <div class="resume-modal-title">Continue Watching</div>
            <div class="resume-modal-message">
                Resume from <span id="resumeTime" class="resume-modal-time"></span>?
            </div>
            <div class="resume-modal-buttons">
                <button id="resumeBtn" class="resume-btn resume-btn-primary">Resume</button>
                <button id="startOverBtn" class="resume-btn resume-btn-secondary">Start Over</button>
            </div>
        </div>
    </div>

    <script type="text/javascript">        
        // Setup player configuration object
        var playerConfig = {
            id: "player",
            file: "<%= typeof m3u8Link !== 'undefined' ? m3u8Link : (typeof videoUrl !== 'undefined' ? videoUrl : '') %>",
            <% if (typeof domain !== 'undefined') { %>
                <% if (typeof contentType !== 'undefined' && contentType === 'movie') { %>
                    url: "<%= domain %>/player/<%= typeof tmdbId !== 'undefined' ? tmdbId : '0' %>",
                    embed: "<%= domain %>/player/<%= typeof tmdbId !== 'undefined' ? tmdbId : '0' %>",
                <% } else if (typeof contentType !== 'undefined' && contentType === 'tv') { %>
                    url: "<%= domain %>/player/<%= typeof tmdbId !== 'undefined' ? tmdbId : '0' %>/season/<%= typeof season !== 'undefined' ? season : '1' %>/episode/<%= typeof episode !== 'undefined' ? episode : '1' %>",
                    embed: "<%= domain %>/player/<%= typeof tmdbId !== 'undefined' ? tmdbId : '0' %>/season/<%= typeof season !== 'undefined' ? season : '1' %>/episode/<%= typeof episode !== 'undefined' ? episode : '1' %>",
                <% } else { %>
                    url: "<%= domain %>/player/<%= typeof tmdbId !== 'undefined' ? tmdbId : '0' %>",
                    embed: "<%= domain %>/player/<%= typeof tmdbId !== 'undefined' ? tmdbId : '0' %>",
                <% } %>
            <% } else { %>
                url: window.location.href,
                embed: window.location.href,
            <% } %>
            poster: "<%= typeof posterPath !== 'undefined' ? 'https://image.tmdb.org/t/p/w500' + posterPath : (typeof splashimgurl !== 'undefined' ? splashimgurl : '') %>",
            title: "<%= title %>",
            duration: "<%= typeof duration !== 'undefined' ? duration : '' %>",
            autoplay: 1
        };
        
        // Initialize Playerjs
        try {
            var player = new Playerjs(playerConfig);
            console.log('Player initialized successfully');
            
            // Test that player is working
            setTimeout(function() {
                console.log('Testing player API...');
                console.log('Player object:', player);
                console.log('Player api function:', typeof player.api);
                
                // Test basic API calls
                try {
                    var duration = player.api('duration');
                    var time = player.api('time');
                    var playing = player.api('playing');
                    console.log('API test results:', { duration, time, playing });
                } catch (e) {
                    console.error('API test failed:', e);
                }
            }, 1000);
        } catch (error) {
            console.error('Failed to initialize player:', error);
        }

        // Function to get cookie value by name
        function getCookie(name) {
            const value = `; ${document.cookie}`;
            const parts = value.split(`; ${name}=`);
            if (parts.length === 2) return parts.pop().split(';').shift();
            return null;
        }

        // Progress tracking variables
        var progressData = {
            <% if (contentType === 'movie') { %>
                tmdbId: "<%= tmdbId %>",
                contentType: "movie",
                title: "<%= title %>",
                id: "movie-<%= tmdbId %>",
            <% } else { %>
                tmdbId: "<%= tmdbId %>",
                season: "<%= season %>",
                episode: "<%= episode %>",
                contentType: "tv",
                title: "<%= title %>",
                id: "tv-<%= tmdbId %>-s<%= season %>e<%= episode %>",
            <% } %>
            poster: "<%= typeof splashimgurl !== 'undefined' ? splashimgurl : '' %>",
            lastSaved: 0,
            duration: 0
        };

        var saveInterval = null;
        var hasStartedTracking = false;

        // Function to save progress to backend
        function saveProgress(currentTime, duration) {
            console.log('saveProgress called with:', { currentTime, duration });
            
            if (!duration || duration <= 0) {
                console.log('Skipping save - invalid duration:', duration);
                return;
            }
            
            var progressPercent = (currentTime / duration) * 100;
            console.log('Progress percent:', progressPercent + '%');
            
            if (progressPercent >= 98) {
                console.log('Progress is 98% or more, deleting document...');
                fetch('/user/watchlist/delete', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    credentials: 'include',
                    body: JSON.stringify({ id: progressData.id })
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        console.log('✅ Progress document deleted successfully.');
                    } else {
                        console.error('❌ Failed to delete progress document:', data);
                    }
                }).catch(error => {
                    console.error('❌ Error deleting progress document:', error);
                });
            }

            // Only save if progress is between 1% and below 98%
            if (progressPercent >= 1 && progressPercent < 98) {
                console.log('Progress is in valid range for saving (1-97%)');
                // Only save if significant time has passed (60 seconds)
                var timeDiff = Math.abs(currentTime - progressData.lastSaved);
                console.log('Time difference since last save:', timeDiff + ' seconds');
                
                if (timeDiff >= 60) {
                    console.log('Time difference is >= 60 seconds, proceeding with save...');
                    
                    console.log('Using session-based authentication...');
                    
                    var requestData = {
                        id: progressData.id,
                        seriesId: progressData.seriesId,
                        season: progressData.season,
                        episode: progressData.episode,
                        time: currentTime,
                        duration: duration,
                        title: progressData.title,
                        player: 'player-embed-ha'
                    };
                    
                    console.log('Request data:', requestData);
                    console.log('Making API call to /user/watchlist/save...');
                    
                    fetch('/user/watchlist/save', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json'
                        },
                        credentials: 'include',
                        body: JSON.stringify(requestData)
                    })
                    .then(response => {
                        console.log('API response status:', response.status);
                        console.log('API response:', response);
                        return response.json();
                    })
                    .then(data => {
                        console.log('API response data:', data);
                        if (data.success) {
                            progressData.lastSaved = currentTime;
                            console.log('✅ Progress saved successfully:', Math.round(progressPercent) + '%');
                        } else {
                            console.error('❌ API returned success=false:', data);
                        }
                    })
                    .catch(error => {
                        console.error('❌ Failed to save progress - Network/Parse error:', error);
                    });
                } else {
                    console.log('Skipping save - not enough time passed (need 60s, got ' + timeDiff + 's)');
                }
            } else {
                console.log('Skipping save - progress not in valid range (need 1-98%, got ' + progressPercent.toFixed(1) + '%)');
            }
        }

        // Start progress tracking using polling approach (since events are buggy)
        setTimeout(function() {
            console.log('Starting progress tracking system...');
            
            // Get initial player status
            try {
                var duration = player.api('duration');
                var time = player.api('time');
                var playing = player.api('playing');
                console.log('Initial player status:', { duration: duration, time: time, playing: playing });
                
                progressData.duration = duration || parseFloat("<%= duration %>") || 0;
                console.log('Progress data duration set to:', progressData.duration);
            } catch (e) {
                console.error('Error getting initial player status:', e);
            }
            
            // Load existing progress - try to load for logged in users
            console.log('Loading existing progress...');
            var progressUrl = '/user/watchlist/progress/' + progressData.seriesId + '/' + progressData.season + '/' + progressData.episode;
            console.log('Fetching progress from:', progressUrl);
            fetch(progressUrl, {
                credentials: 'include'
            })
                .then(response => response.json())
                .then(data => {
                    console.log('Progress load response:', data);
                    if (data.success && data.progress && data.progress.time > 0) {
                        var resumeTime = data.progress.time;
                        var resumeDuration = data.progress.duration || progressData.duration;
                        var progressPercent = Math.round((resumeTime / resumeDuration) * 100);
                        
                        console.log('Found saved progress:', {
                            time: resumeTime,
                            duration: resumeDuration,
                            percent: progressPercent
                        });
                        
                        // Format time for display
                        var minutes = Math.floor(resumeTime / 60);
                        var seconds = Math.floor(resumeTime % 60);
                        var hours = Math.floor(resumeTime / 3600);
                        var minutes = Math.floor((resumeTime % 3600) / 60);
                        var seconds = Math.floor(resumeTime % 60);
                        var timeDisplay = hours > 0
                            ? `${hours}:${minutes.toString().padStart(2, '0')}:${seconds.toString().padStart(2, '0')}`
                            : `${minutes}:${seconds.toString().padStart(2, '0')}`;
                        
                        // Show beautiful resume modal
                        document.getElementById('resumeTime').textContent = `${timeDisplay} (${progressPercent}%)`;
                        document.getElementById('resumeModal').classList.add('show');
                        
                        // Handle resume button click
                        document.getElementById('resumeBtn').onclick = function() {
                            console.log('User chose to resume, seeking to:', resumeTime);
                            document.getElementById('resumeModal').classList.remove('show');
                            
                            // Wait a bit longer for player to be ready
                            setTimeout(function() {
                                try {
                                    player.api('seek', resumeTime);
                                    console.log('✅ Successfully seeked to resume time:', resumeTime);
                                    
                                    // Update lastSaved to prevent immediate re-save
                                    progressData.lastSaved = resumeTime;
                                } catch (e) {
                                    console.error('❌ Error seeking to resume time:', e);
                                }
                            }, 1000);
                        };
                        
                        // Handle start over button click
                        document.getElementById('startOverBtn').onclick = function() {
                            console.log('User chose to start over');
                            document.getElementById('resumeModal').classList.remove('show');
                        };
                    } else {
                        console.log('No saved progress found or progress is 0');
                    }
                })
                .catch(error => {
                    console.log('Failed to load progress (user might not be logged in):', error.message);
                });
            
            // Start polling the player status every 5 seconds
            var pollInterval = setInterval(function() {
                try {
                    var currentTime = player.api('time');
                    var duration = player.api('duration') || progressData.duration;
                    var isPlaying = player.api('playing');
                    
                    console.log('Poll check - Time:', currentTime, 'Duration:', duration, 'Playing:', isPlaying);
                    
                    // Update duration if we got a better value
                    if (duration > progressData.duration) {
                        progressData.duration = duration;
                        console.log('Updated duration to:', duration);
                    }
                    
                    // Only track progress when playing
                    if (isPlaying && currentTime > 0 && duration > 0) {
                        // Check if we should save progress (every 60 seconds)
                        if (Math.abs(currentTime - progressData.lastSaved) >= 60) {
                            console.log('60 seconds passed, saving progress...');
                            saveProgress(currentTime, duration);
                        }
                    }
                } catch (e) {
                    console.error('Error in poll interval:', e);
                }
            }, 5000); // Check every 5 seconds
            
            // Also save on page unload
            window.addEventListener('beforeunload', function() {
                try {
                    var currentTime = player.api('time');
                    var duration = player.api('duration') || progressData.duration;
                    
                    if (currentTime > 0 && duration > 0) {
                        console.log('Saving progress before page unload');
                        // Use sendBeacon for more reliable sending on page unload
                        var data = JSON.stringify({
                            id: progressData.id,
                            seriesId: progressData.seriesId,
                            season: progressData.season,
                            episode: progressData.episode,
                            time: currentTime,
                            duration: duration,
                            title: progressData.title,
                            poster: progressData.poster
                        });
                        
                        navigator.sendBeacon('/user/watchlist/save', data);
                    }
                } catch (e) {
                    console.error('Error saving progress on unload:', e);
                }
            });
            
            console.log('Progress tracking system initialized successfully');
            
        }, 2000); // Wait 2 seconds for player to be fully initialized


        // Clean up interval on page unload
        window.addEventListener('unload', function() {
            if (saveInterval) {
                clearInterval(saveInterval);
            }
        });

    </script>
</body>

</html>