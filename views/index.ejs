    <!-- Stylesheets -->
    <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/4.1.3/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://use.fontawesome.com/releases/v5.3.1/css/all.css">
    <link rel="stylesheet" href="/css/theme_1.css">

    <!-- Schema Markup for Homepage -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": "HA Entertainment",
      "url": "https://www.ha-entertainment.com",
      "description": "HA Entertainment offers the best selection of free movies and TV series online. Enjoy streaming movies in Full HD quality, all for free!",
      "publisher": {
        "@type": "Organization",
        "name": "HA Entertainment",
        "logo": {
          "@type": "ImageObject",
          "url": "https://www.ha-entertainment.com/images/header.jpg",
