<body id="gMNrTK">
    <div id="mobile-overlay" class=""></div>
    <div id="menu-display" class="">
        <ul class="nav menu-display-list">
            <li class="nav-item active"><a class="nav-link" href="/" title="Home">Home</a></li>
            <li class="nav-item"><a class="nav-link" href="/movies" title="Movies">Movies</a></li>
            <li class="nav-item"><a class="nav-link" href="/tv-series" title="TV Series">TV Series</a></li>
            
            <li class="nav-item"><a class="nav-link" href="/contact-us" title="Contact Us">Contact Us</a></li>
        </ul>
    </div>
    <div id="app">
        <!--/// Header ///-->
        <header class="over-air">
            <div class="container">
                <div id="header_elements">
                    <div class="btn btn-touch mobile-button" id="mobile_menu"><i class="fas fa-bars"></i></div>
                    <a href="/" id="header_logo">
                        <img src="/images/logo.png" alt="HA Entertainment">
                    </a>
                    <div id="header_search">
                        <div class="search-elements">
                            <form id="search-form" action="/search" method="GET">
                                <div class="search-submit">
                                    <div class="search-icon"><i class="fa fa-search"></i></div>
                                </div>
                                <input name="keyword" type="text" id="search-input" class="form-control is-input"
                                    placeholder="Search for movies or TV series" />
                            </form>
                            <div id="search-suggestions" class="is-result search-suggest" style="display: none;">
                            </div>
                        </div>
                    </div>
                    <div id="header_menu">
                        <div class="menu-item">
                            <a href="/" class="menu-link active">Home</a>
                        </div>
                        <div class="menu-item">
                            <a href="/movies" class="menu-link">Movies</a>
                        </div>
                        <div class="menu-item">
                            <a href="/tv-series" class="menu-link">TV Series</a>
                        </div>

                        <div class="menu-item">
                            <a href="/contact-us" class="menu-link">Contact Us</a>
                        </div>
                    </div>
                    <div class="flex-grow"></div>
                    <div class="btn btn-touch mobile-button" id="mobile_search"><i class="fas fa-search"></i></div>
                </div>
            </div>
        </header>
        <!--/// Page body ///-->
        <div id="slider" style="overflow-x: hidden;">
            <div class="swiper-wrapper">
                <% trendingContent.forEach(item=> { %>
                    <div class="swiper-slide">
                        <div class="slide-cover-slider">
                            <img src="https://image.tmdb.org/t/p/w780<%= item.backdrop_path %>"
                                alt="<%= item.title || item.name %>">
                        </div>
                        <div class="container">
                            <div class="slide-element">
                                <!-- <div class="is-poster">
                                    <a href=""
                                        class="poster-mask">
                                        <div><i class="fas fa-play"></i></div>
                                    </a>
                                    <img src=""
                                        alt="">
                                </div> -->
                                <div class="is-caption">
                                    <div class="film-info">
                                        <span class="item is-quality">HD</span>
                                        <span class="item">
                                            <%= item.media_type==='movie' ? 'Movie' : 'TV Series' %>
                                        </span>
                                        <span class="item">
                                            <%= new Date(item.release_date || item.first_air_date).getFullYear() %>
                                        </span>
                                    </div>
                                    <h2 class="heading-xl sum-2">
                                        <a href="<%= item.media_type === 'movie' ? '/watch-movie/' + item.id : '/watch-series/' + item.id %>"
                                            title="<%= item.title || item.name %>">
                                            <%= item.title || item.name %>
                                        </a>
                                    </h2>
                                    
                                    <div class="div-buttons">
                                        <a href="<%= item.media_type === 'movie' ? '/watch-movie/' + item.id : '/watch-series/' + item.id %>"
                                            class="btn w-icon btn-watch">
                                            <i class="fas fa-play mr-3"></i>Watch now
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <% }); %>
            </div>
            <div class="slider-controls">
                <div class="button-next"><i class="fas fa-angle-right"></i></div>
                <div class="button-prev"><i class="fas fa-angle-left"></i></div>
            </div>
            <div class="swiper-pagination"></div>
        </div>
        <section class="section-default section-flow-vertical section-film-list is-carousel">
            <div class="container">
                <div class="section-header">
                    <div class="is-title">
                        <h2 class="heading-md">Trending</h2>
                    </div>
                    <div class="flex-tabs">
                        <ul class="nav nav-tabs radius-tabs">
                            <li class="nav-item"><a data-toggle="tab" href="#trending-movies"
                                    class="nav-link active">Movies</a></li>
                            <li class="nav-item"><a data-toggle="tab" href="#trending-series" class="nav-link">TV
                                    Series</a></li>
                        </ul>
                    </div>
                    <div class="flex-grow"></div>
                </div>
                <div class="section-body">
                    <div class="tab-content">
                        <div id="trending-movies" class="tab-pane fade active show">
                            <div class="film-list">
                                <% if (trendingMovies && trendingMovies.length) { %>
                                    <% trendingMovies.forEach(item=> { %>
                                        <div class="item-film">
                                            <a href="/watch-movie/<%= item.id %>" class="film-mask"></a>
                                            <div class="film-thumbnail">
                                                <div class="badge-tag quality">HD</div>
                                                <img class="film-thumbnail-img"
                                                    src="https://image.tmdb.org/t/p/w342<%= item.poster_path %>"
                                                    alt="<%= item.title %>">
                                            </div>
                                            <div class="film-detail">
                                                <h3 class="film-name sum-2">
                                                    <a href="/watch-movie/<%= item.id %>" title="<%= item.title %>">
                                                        <%= item.title %>
                                                    </a>
                                                </h3>
                                                <div class="film-info">
                                                    <span class="item">Movie</span>
                                                    <span class="item">
                                                        <%= new Date(item.release_date).getFullYear() %>
                                                    </span>
                                                </div>
                                            </div>
                                        </div>
                                        <% }); %>
                                            <% } else { %>
                                                <p>No trending movies available.</p>
                                                <% } %>
                            </div>
                        </div>
                        <div id="trending-series" class="tab-pane fade">
                            <div class="film-list">
                                <% if (trendingSeries && trendingSeries.length) { %>
                                    <% trendingSeries.forEach(item=> { %>
                                        <div class="item-film">
                                            <a href="/watch-series/<%= item.id %>" class="film-mask"></a>
                                            <div class="film-thumbnail">
                                                <div class="badge-tag quality">HD</div>
                                                <img class="film-thumbnail-img"
                                                    src="https://image.tmdb.org/t/p/w342<%= item.poster_path %>"
                                                    alt="<%= item.name %>">
                                            </div>
                                            <div class="film-detail">
                                                <h3 class="film-name sum-2">
                                                    <a href="/watch-series/<%= item.id %>" title="<%= item.name %>">
                                                        <%= item.name %>
                                                    </a>
                                                </h3>
                                                <div class="film-info">
                                                    <span class="item">TV Series</span>
                                                    <span class="item">
                                                        <%= new Date(item.release_date).getFullYear() %>
                                                    </span>
                                                </div>
                                            </div>
                                        </div>
                                        <% }); %>
                                            <% } else { %>
                                                <p>No trending series available.</p>
                                                <% } %>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Top Rated Movies and TV Series Section -->
        <section class="section-default section-flow-vertical is-single">
            <div class="container">
                <div class="section-header w-tabs">
                    <div class="is-title">
                        <h2 class="heading-md">Top Rated</h2>
                        <div class="description">Movies and TV Series are highly rated by users</div>
                    </div>
                    <div class="flex-tabs">
                        <ul class="nav nav-tabs radius-tabs">
                            <li class="nav-item"><a data-toggle="tab" href="#topRated-movies"
                                    class="nav-link active">Movies</a></li>
                            <li class="nav-item"><a data-toggle="tab" href="#topRated-series" class="nav-link">TV
                                    Series</a></li>
                        </ul>
                    </div>
                    <div class="flex-grow"></div>
                </div>
            </div>
            <div class="single-element is-blue">
                <div class="tab-content">
                    <!-- Top Rated Movies -->
                    <div id="topRated-movies" class="tab-pane fade show active">
                        <div class="slide-element rtl">
                            <% if (topRatedMovies && topRatedMovies.length> 0) { %>
                                <% const topMovie=topRatedMovies[0]; %>
                                    <div class="is-poster">
                                        <a href="/watch-movie/<%= topMovie.id %>" class="poster-mask"
                                            title="<%= topMovie.title %>">
                                            <div><i class="fas fa-play"></i></div>
                                        </a>
                                        <div class="badge-tag position">01</div>
                                        <img src="https://image.tmdb.org/t/p/w780<%= topMovie.backdrop_path %>"
                                            alt="<%= topMovie.title %>">
                                    </div>
                                    <div class="is-caption">
                                        <div class="film-info">
                                            <span class="item is-quality">HD</span>
                                            <span class="item">Movie</span>
                                            <span class="item">
                                                <%= new Date(topMovie.release_date).getFullYear() %>
                                            </span>
                                        </div>
                                        <h2 class="heading-xl sum-2">
                                            <a href="/watch-movie/<%= topMovie.id %>" title="<%= topMovie.title %>">
                                                <%= topMovie.title %>
                                            </a>
                                        </h2>
                                        <div class="div-buttons">
                                            <a href="/watch-movie/<%= topMovie.id %>" class="btn w-icon btn-watch"><i
                                                    class="fas fa-play mr-3"></i>Watch now</a>
                                        </div>
                                    </div>
                                    <% } %>
                        </div>
                        <div id="carousel-top-rated-movies" class="film-carousel popular-carousel">
                            <div class="swiper-container">
                                <div class="swiper-wrapper">
                                    <% topRatedMovies.slice(1).forEach(movie=> { %>
                                        <div class="swiper-slide">
                                            <div class="item-film">
                                                <a href="/watch-movie/<%= movie.id %>" class="film-mask"></a>
                                                <div class="film-thumbnail">
                                                    <div class="badge-tag quality">HD</div>
                                                    <img class="film-thumbnail-img"
                                                        src="https://image.tmdb.org/t/p/w342<%= movie.poster_path %>"
                                                        alt="<%= movie.title %>">
                                                </div>
                                                <div class="film-detail">
                                                    <h3 class="film-name sum-2"><a href="/watch-movie/<%= movie.id %>"
                                                            title="<%= movie.title %>">
                                                            <%= movie.title %>
                                                        </a></h3>
                                                    <div class="film-info">
                                                        <span class="item">Movie</span>
                                                        <span class="item">
                                                            <%= new Date(movie.release_date).getFullYear() %>
                                                        </span>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        <% }); %>
                                </div>
                            </div>
                            <div class="carousel-controls">
                                <div class="button-next"><i class="fas fa-angle-right"></i></div>
                                <div class="button-prev"><i class="fas fa-angle-left"></i></div>
                            </div>
                        </div>
                    </div>
                    <!-- Top Rated TV Series -->
                    <div id="topRated-series" class="tab-pane fade">
                        <div class="slide-element rtl">
                            <% if (topRatedSeries && topRatedSeries.length> 0) { %>
                                <% const topSeries=topRatedSeries[0]; %>
                                    <div class="is-poster">
                                        <a href="/watch-series/<%= topSeries.id %>" class="poster-mask"
                                            title="<%= topSeries.name %>">
                                            <div><i class="fas fa-play"></i></div>
                                        </a>
                                        <div class="badge-tag position">01</div>
                                        <img src="https://image.tmdb.org/t/p/w780<%= topSeries.backdrop_path %>"
                                            alt="<%= topSeries.name %>">
                                    </div>
                                    <div class="is-caption">
                                        <div class="film-info">
                                            <span class="item is-quality">HD</span>
                                            <span class="item">TV Series</span>
                                            <span class="item">
                                                <%= new Date(topSeries.release_date).getFullYear() %>
                                            </span>
                                        </div>
                                        <h2 class="heading-xl sum-2">
                                            <a href="/watch-series/<%= topSeries.id %>" title="<%= topSeries.name %>">
                                                <%= topSeries.name %>
                                            </a>
                                        </h2>
                                        <div class="div-buttons">
                                            <a href="/watch-series/<%= topSeries.id %>" class="btn w-icon btn-watch"><i
                                                    class="fas fa-play mr-3"></i>Watch now</a>
                                        </div>
                                    </div>
                                    <% } %>
                        </div>
                        <div id="carousel-top-rated-series" class="film-carousel popular-carousel">
                            <div class="swiper-container">
                                <div class="swiper-wrapper">
                                    <% topRatedSeries.slice(1).forEach(series=> { %>
                                        <div class="swiper-slide">
                                            <div class="item-film">
                                                <a href="/watch-series/<%= series.id %>" class="film-mask"></a>
                                                <div class="film-thumbnail">
                                                    <div class="badge-tag quality">HD</div>
                                                    <img class="film-thumbnail-img"
                                                        src="https://image.tmdb.org/t/p/w342<%= series.poster_path %>"
                                                        alt="<%= series.name %>">
                                                </div>
                                                <div class="film-detail">
                                                    <h3 class="film-name sum-2"><a href="/watch-series/<%= series.id %>"
                                                            title="<%= series.name %>">
                                                            <%= series.name %>
                                                        </a></h3>
                                                    <div class="film-info">
                                                        <span class="item">TV Series</span>
                                                        <span class="item">
                                                            <%= new Date(series.release_date).getFullYear() %>
                                                        </span>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        <% }); %>
                                </div>
                            </div>
                            <div class="carousel-controls">
                                <div class="button-next"><i class="fas fa-angle-right"></i></div>
                                <div class="button-prev"><i class="fas fa-angle-left"></i></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Footer Section -->
        <div class="flex-grow"></div>
        <footer>
            <div class="footer-top">
                <div class="container">
                    <div class="d-flex footer-elements">
                        <div class="footer-logo">
                            <a href="/" class="is-logo"><img src="/images/logo.png" alt="HA Entertainment"></a>
                        </div>
                        <div class="footer-about">
                            <div class="heading-sm mb-3">About Us</div>
                            <p>HA Entertainment is free tv shows streaming website with zero ads, it
                                allows you <strong>watch tv shows online</strong>, <strong>watch tv shows online
                                    free</strong>
                                in high quality for free.
                            </p>
                            <small>This site does not store any files on our server, we only linked to the media which
                                is hosted
                                on 3rd party services.</small>
                            <div class="links pt-5">
                                <a href="/sitemap.xml">Sitemap</a>
                                <a href="/contact-us">Contact</a>
                                <a href="/terms">Terms of service</a>
                                <br>
                                <a href="https://turkish.ha-entertainment.com/">Turkish Series (Urdu Subtitle & Urdu Dubbing)</a>

                            </div>
                        </div>
                        <div class="footer-menu">
                            <div class="heading-sm mb-3">Links</div>
                            <div class="d-flex">
                                <ul class="style-none">
                                    <li><a href="/movies">Movies</a></li>
                                    <li><a href="/tv-series">TV Series</a></li>
                                    
                                </ul>
                            </div>
                        </div>
                        <div class="flex-grow"></div>
                        <div class="footer-up">
                            <a href="#app" class="btn btn-lg btn-light w-icon linknav"><i
                                    class="fas fa-angle-up mr-2"></i><strong>Top</strong></a>
                        </div>
                    </div>
                </div>
            </div>
        </footer>
    </div>
    <!-- Begin: Scripts -->
    <script src="https://code.jquery.com/jquery-3.3.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.1.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/search.js"></script>
    <script src="/js/app.min.js"></script>
    <!-- End: Scripts -->
</body>

</html>