        <div id="page-detail">
            <!-- All Movies Section -->
            <% if (type.includes('1')) { %>
                <section class="section-default section-flow-vertical section-page section-film-list is-head-cate is-list">
                    <div class="container">
                        <div class="section-header">
                            <div class="is-title">
                                <h2 class="heading-md">All Movies</h2>
                            </div>
                            <div class="is-more">
                                <!-- Add any additional links or buttons here -->
                            </div>
                            <div class="flex-grow"></div>
                        </div>
                        <div class="section-body">
                            <div class="film-list">
                                <% if (movies.length > 0) { %>
                                    <% movies.forEach(movie => { %>
                                        <div class="item-film">
                                            <a href="/movie/<%= movie.id %>" class="film-mask"></a>
                                            <div class="film-thumbnail">
                                                <div class="badge-tag quality">HD</div>
                                                <img class="film-thumbnail-img" src="https://image.tmdb.org/t/p/w185/<%= movie.poster_path %>" alt="<%= movie.title %>">
                                            </div>
                                            <div class="film-detail">
                                                <h3 class="film-name sum-2">
                                                    <a href="/movie/<%= movie.id %>" title="<%= movie.title %>"><%= movie.title %></a>
                                                </h3>
                                                <div class="film-info">
                                                    <span class="item">Movie</span>
                                                    <span class="item"><%= new Date(movie.release_date).getFullYear() %></span>
                                                </div>
                                            </div>
                                        </div>
                                    <% }); %>
                                <% } else { %>
                                    <p>No movies found.</p>
                                <% } %>
    
                                <% if (totalPages > 1) { %>
                                    <div class="section-pagination">
                                        <nav aria-label="Page navigation">
                                            <ul class="pagination justify-content-center mb-0">
                                                <% if (currentPage > 1) { %>
                                                    <li class="page-item">
                                                        <a class="page-link" href="?type=<%= type %>&genre=<%= genre %>&country=<%= country %>&quality=<%= quality %>&year=<%= year %>&sort=<%= sort %>&page=1" aria-label="First">
                                                            <span aria-hidden="true"><i class="fa fa-angle-double-left"></i></span>
                                                            <span class="sr-only">First</span>
                                                        </a>
                                                    </li>
                                                    <li class="page-item">
                                                        <a class="page-link" href="?type=<%= type %>&genre=<%= genre %>&country=<%= country %>&quality=<%= quality %>&year=<%= year %>&sort=<%= sort %>&page=<%= currentPage - 1 %>" aria-label="Previous">
                                                            <span aria-hidden="true"><i class="fa fa-angle-left"></i></span>
                                                            <span class="sr-only">Previous</span>
                                                        </a>
                                                    </li>
                                                <% } %>
    
                                                <% 
                                                const maxPagesToShow = 3; // Define the number of page links to show
                                                const startPage = Math.max(1, currentPage - Math.floor(maxPagesToShow / 2));
                                                const endPage = Math.min(totalPages, startPage + maxPagesToShow - 1);
    
                                                for (let i = startPage; i <= endPage; i++) { %>
                                                    <li class="page-item <%= i === currentPage ? 'active' : '' %>">
                                                        <a class="page-link" href="?type=<%= type %>&genre=<%= genre %>&country=<%= country %>&quality=<%= quality %>&year=<%= year %>&sort=<%= sort %>&page=<%= i %>"><%= i %></a>
                                                    </li>
                                                <% } %>
    
                                                <% if (currentPage < totalPages) { %>
                                                    <li class="page-item">
                                                        <a class="page-link" href="?type=<%= type %>&genre=<%= genre %>&country=<%= country %>&quality=<%= quality %>&year=<%= year %>&sort=<%= sort %>&page=<%= currentPage + 1 %>" aria-label="Next">
                                                            <span aria-hidden="true"><i class="fa fa-angle-right"></i></span>
                                                            <span class="sr-only">Next</span>
                                                        </a>
                                                    </li>
                                                    <li class="page-item">
                                                        <a class="page-link" href="?type=<%= type %>&genre=<%= genre %>&country=<%= country %>&quality=<%= quality %>&year=<%= year %>&sort=<%= sort %>&page=<%= totalPages %>" aria-label="Last">
                                                            <span aria-hidden="true"><i class="fa fa-angle-double-right"></i></span>
                                                            <span class="sr-only">Last</span>
                                                        </a>
                                                    </li>
                                                <% } %>
                                            </ul>
                                        </nav>
                                    </div>
                                <% } %>
                            </div>
                        </div>
                    </div>
                </section>
            <% } %>
    
            <!-- All TV Series Section -->
