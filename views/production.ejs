<!DOCTYPE html>
<html lang="en">

<head>
    <title>Production Company: <%= productionName %> - HA Entertainment</title>

    <!-- Meta Tags -->
    <meta charset="UTF-8">
    <meta name="robots" content="index, follow">
    <meta http-equiv="content-language" content="en" />
    <meta name="description" content="Learn more about <%= productionName %> on HA Entertainment. Discover their films, TV series, and more." />
    <meta name="keywords" content="<%= productionName %>, production company, film production, TV production, HA Entertainment" />
    <meta name="viewport" content="width=device-width, initial-scale=1, minimum-scale=1, maximum-scale=1" />

    <!-- Canonical Link -->
    <link rel="canonical" href="https://www.ha-entertainment.com/production/<%= productionId %>" />

    <!-- Favicon and Icons -->
    <link rel="shortcut icon" href="https://www.ha-entertainment.com/images/logo.png" type="image/x-icon" />
    <link rel="icon" type="image/png" sizes="32x32" href="https://www.ha-entertainment.com/images/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="https://www.ha-entertainment.com/images/favicon-16x16.png">
    <link rel="apple-touch-icon" sizes="180x180" href="https://www.ha-entertainment.com/images/apple-touch-icon.png">

    <!-- Open Graph Meta Tags -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content="Production Company: <%= productionName %> - HA Entertainment" />
    <meta property="og:url" content="https://www.ha-entertainment.com/production/<%= productionId %>" />
    <meta property="og:image" content="https://image.tmdb.org/t/p/w780<%= Logo %>" />
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:description" content="Discover the production company <%= productionName %>, their films, and TV series on HA Entertainment." />
    <meta property="og:site_name" content="HA Entertainment" />

    <!-- Twitter Card Meta Tags -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:site" content="@HA_Entertainment">
    <meta name="twitter:title" content="Production Company: <%= productionName %> - HA Entertainment">
    <meta name="twitter:description" content="Discover the production company <%= productionName %>, their films, and TV series on HA Entertainment.">
    <meta name="twitter:image" content="https://image.tmdb.org/t/p/w780<%= Logo %>">

    <!-- Stylesheets -->
    <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/4.1.3/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://use.fontawesome.com/releases/v5.3.1/css/all.css">
    <link rel="stylesheet" href="/css/theme_1.css">

    <!-- Schema Markup for Production Company Page -->
    <script type="application/ld+json">
        {
          "@context": "https://schema.org",
          "@type": "Organization",
          "name": "<%= productionName %>",
          "url": "https://www.ha-entertainment.com/production/<%= productionId %>",
          "logo": {
            "@type": "ImageObject",
            "url": "https://image.tmdb.org/t/p/original<%= Logo %>"
          }
        }
    </script>

    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-VS8TC16J1Q"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-VS8TC16J1Q');
    </script>
<script type="text/javascript">
    (function(c,l,a,r,i,t,y){
        c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
        t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
        y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
    })(window, document, "clarity", "script", "nr75009c7m");
</script>
</head>


